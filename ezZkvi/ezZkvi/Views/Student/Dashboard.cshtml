@model ezZkvi.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    // Bosanski datum (npr. "Subota · 23. Maj 2026")
    var bsCulture = new System.Globalization.CultureInfo("bs-Latn-BA");
    var trenutniDatum = DateTime.Now.ToString("dddd · dd. MMMM yyyy", bsCulture);

    var userName = User.Identity?.Name ?? "Korisnik";
    var initials = userName.Length >= 2 ? userName.Substring(0, 2).ToUpper() : userName.ToUpper();

    // Logo vodi na dashboard prema ulozi
    var logoController = User.IsInRole("Admin") ? "Administrator" : (User.IsInRole("Moderator") ? "Moderator" : "Student");

    // Procenat napunjenosti XP trake za trenutni nivo
    var xpPostotak = Model.XpZaNivo > 0 ? Model.XpUNivou * 100 / Model.XpZaNivo : 0;
}

@section Styles {
<style>
  :root {
    --bg: #080C14; --surface: #0F1620; --card: #141D2B;
    --border: #1E2D42; --accent: #bfc0c3; --amber: #d6d6d8;
    --text: #E8EDF5; --muted: #5A7090; --success: #00E676; --danger: #FF5252;
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  body { background:var(--bg); color:var(--text); font-family:'DM Sans',sans-serif; min-height:100vh; }
  .layout { display:flex; min-height:100vh; }

  .sidebar {
    width:220px; background:var(--surface); border-right:1px solid var(--border);
    padding:24px 0; display:flex; flex-direction:column; flex-shrink:0;
    transition: transform 0.3s ease;
  }
  .logo {
    font-family:'Space Grotesk',sans-serif; font-size:1.5rem; font-weight:700;
    letter-spacing:2px; color:var(--text); padding:0 24px 24px;
    border-bottom:1px solid var(--border); cursor:pointer;
    text-decoration:none; display:block;
  }
  .logo span { color:var(--accent); }
  .nav { padding:20px 12px; flex:1; }
  .nav-item {
    display:flex; align-items:center; gap:12px;
    padding:10px 12px; border-radius:8px; cursor:pointer;
    font-size:0.88rem; color:var(--muted); margin-bottom:4px;
    transition:all 0.2s; text-decoration:none; position:relative;
  }
  .nav-item:hover, .nav-item.active { background:rgba(194,194,198,0.08); color:var(--accent); }
  .nav-item .ico { font-size:1.1rem; width:20px; text-align:center; }
  .nav-badge {
    position:absolute; right:10px; top:50%; transform:translateY(-50%);
    background:var(--accent); color:var(--bg); font-size:0.6rem; font-weight:700;
    padding:1px 6px; border-radius:8px;
  }
  .user-card {
    margin:12px; padding:12px; background:var(--card);
    border:1px solid var(--border); border-radius:10px; cursor:pointer;
    transition:all 0.2s; text-decoration:none; display:block; color:var(--text);
  }
  .user-card:hover { border-color:var(--danger); }
  .user-card .top { display:flex; align-items:center; gap:10px; }
  .user-avatar-sm {
    width:36px; height:36px; border-radius:50%;
    background:rgba(194,194,198,0.1); display:flex; align-items:center;
    justify-content:center; font-family:'Space Grotesk',sans-serif;
    font-weight:700; color:var(--accent); font-size:0.85rem; flex-shrink:0;
  }
  .user-name { font-weight:600; font-size:0.88rem; }
  .user-role { font-size:0.68rem; letter-spacing:2px; color:var(--accent); text-transform:uppercase; margin-top:2px; }
  .logout-hint { font-size:0.65rem; color:var(--muted); margin-top:4px; opacity:0; transition:opacity 0.2s; }
  .user-card:hover .logout-hint { opacity:1; color:var(--danger); }

  .main { flex:1; padding:32px; overflow-y:auto; }
  .topbar { display:flex; justify-content:space-between; align-items:center; margin-bottom:28px; flex-wrap:wrap; gap:12px; }
  .greeting { font-family:'Space Grotesk',sans-serif; font-size:1.7rem; font-weight:700; letter-spacing:1px; }
  .greeting span { color:var(--accent); }
  .date-badge { font-size:0.76rem; letter-spacing:2px; color:var(--muted); text-transform:uppercase; }

  .menu-toggle { display:none; background:var(--surface); border:1px solid var(--border); border-radius:8px; padding:8px 12px; color:var(--text); font-size:1.2rem; cursor:pointer; }
  .sidebar-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:9; }

  /* Stats */
  .stats { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:28px; }
  .stat-card {
    background:var(--card); border:1px solid var(--border); border-radius:12px;
    padding:20px; animation:fadeUp 0.5s ease both;
    transition: all 0.2s; cursor:default;
  }
  .stat-card:hover { border-color:rgba(194,194,198,0.3); transform:translateY(-2px); }
  .stat-card:nth-child(2){animation-delay:.1s}
  .stat-card:nth-child(3){animation-delay:.2s}
  .stat-card:nth-child(4){animation-delay:.3s}
  .stat-label { font-size:0.7rem; letter-spacing:2px; color:var(--muted); text-transform:uppercase; margin-bottom:10px; }
  .stat-val { font-family:'Space Grotesk',sans-serif; font-size:2.1rem; font-weight:700; }
  .stat-val.a{color:var(--accent)} .stat-val.b{color:var(--amber)} .stat-val.g{color:var(--success)}
  .stat-sub { font-size:0.76rem; color:var(--muted); margin-top:4px; }
  .stat-trend { font-size:0.72rem; margin-top:6px; }
  .trend-up { color:var(--success); }

  /* XP bar */
  .xp-bar-wrap { margin-top:8px; }
  .xp-bar-bg { height:4px; background:var(--border); border-radius:4px; overflow:hidden; }
  .xp-bar-fill { height:100%; background:linear-gradient(90deg, var(--accent), var(--success)); border-radius:4px; transition:width 1s ease; }
  .xp-labels { display:flex; justify-content:space-between; font-size:0.65rem; color:var(--muted); margin-top:3px; }

  .row2 { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px; }

  .section-card {
    background:var(--card); border:1px solid var(--border); border-radius:12px;
    padding:22px; animation:fadeUp 0.5s ease 0.2s both;
  }
  .section-title {
    font-family:'Space Grotesk',sans-serif; font-size:0.95rem; font-weight:600;
    letter-spacing:2px; text-transform:uppercase; color:var(--muted);
    margin-bottom:16px; display:flex; align-items:center; gap:8px;
  }
  .section-title::before { content:''; width:3px; height:14px; background:var(--accent); border-radius:2px; }
  .active-quiz-banner {
    background: rgba(194, 194, 198, 0.06);
    border: 1px solid rgba(194, 194, 198, 0.28);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 24px;
    animation: fadeUp 0.5s ease both;
}

    .active-quiz-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .active-quiz-title {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--accent);
        margin-bottom: 8px;
    }

    .active-quiz-text {
        color: var(--muted);
        font-size: 0.88rem;
        line-height: 1.5;
    }

    .active-quiz-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .active-quiz-time {
        min-width: 100px;
        padding: 9px 12px;
        border-radius: 10px;
        border: 1px solid rgba(255, 179, 0, 0.35);
        background: rgba(255, 179, 0, 0.08);
        text-align: center;
    }

    .active-quiz-time-label {
        font-size: 0.65rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 2px;
    }

    .active-quiz-time-value {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--amber);
        line-height: 1;
    }

    .active-quiz-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 0 18px;
        border-radius: 9px;
        background: var(--accent);
        color: var(--bg);
        text-decoration: none;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 800;
        font-size: 0.82rem;
        letter-spacing: 1px;
        text-transform: uppercase;
        transition: all 0.2s;
    }

    .active-quiz-btn:hover {
        background: #ffffff;
        color: var(--bg);
        text-decoration: none;
        transform: translateY(-1px);
    }

  .action-btn {
    display:flex; align-items:center; gap:14px; padding:14px;
    background:var(--surface); border:1px solid var(--border); border-radius:10px;
    cursor:pointer; transition:all 0.25s; margin-bottom:10px;
    text-decoration:none; color:var(--text);
  }
  .action-btn:hover { border-color:var(--accent); background:rgba(194,194,198,0.05); transform:translateX(4px); }
  .action-icon {
    width:40px; height:40px; border-radius:8px;
    display:flex; align-items:center; justify-content:center; font-size:1.2rem; flex-shrink:0;
    background:rgba(194,194,198,0.08);
  }
  .action-icon.amber { background:rgba(255,179,0,0.08); }
  .action-icon.green { background:rgba(0,230,118,0.08); }
  .action-text { font-size:0.88rem; font-weight:600; }
  .action-sub { font-size:0.75rem; color:var(--muted); margin-top:2px; }

  .activity-item {
    display:flex; align-items:center; gap:12px; padding:10px 0;
    border-bottom:1px solid var(--border); cursor:pointer; transition:background 0.2s;
  }
  .activity-item:last-child { border-bottom:none; }
  .activity-item:hover { background:rgba(194,194,198,0.03); margin:0 -10px; padding:10px; border-radius:6px; }
  .activity-dot { width:8px; height:8px; border-radius:50%; background:var(--accent); flex-shrink:0; }
  .activity-dot.amber { background:var(--amber); }
  .activity-dot.muted { background:var(--border); }
  .activity-info { flex:1; }
  .activity-name { font-size:0.86rem; font-weight:600; }
  .activity-time { font-size:0.72rem; color:var(--muted); margin-top:2px; }
  .activity-score { font-family:'Space Grotesk',sans-serif; font-weight:700; color:var(--accent); font-size:0.95rem; }

  .subject-list { display:flex; flex-direction:column; gap:10px; }
  .subject-item {
    padding:14px 16px; background:var(--surface); border:1px solid var(--border);
    border-radius:10px; display:flex; align-items:center; gap:14px;
    cursor:pointer; transition:all 0.2s;
  }
  .subject-item:hover { border-color:var(--accent); background:rgba(194,194,198,0.04); }
  .subject-ico { font-size:1.3rem; width:32px; text-align:center; flex-shrink:0; }
  .subject-info { flex:1; }
  .subject-name { font-size:0.88rem; font-weight:600; margin-bottom:6px; }
  .progress-bar { height:3px; background:var(--border); border-radius:3px; overflow:hidden; }
  .progress-fill { height:100%; border-radius:3px; transition:width 1.2s ease; }
  .subject-meta { text-align:right; flex-shrink:0; }
  .subject-count { font-size:0.76rem; color:var(--muted); }
  .subject-pct { font-family:'Space Grotesk',sans-serif; font-weight:700; font-size:1rem; }

  .no-results { text-align:center; padding:40px 0; color:var(--muted); }
  .no-results .ico { font-size:2.5rem; margin-bottom:12px; }
  .no-results p { font-size:0.9rem; margin-bottom:16px; }
  .no-results a {
    display:inline-block; padding:10px 24px; background:var(--accent); color:var(--bg);
    border-radius:8px; text-decoration:none; font-family:'Space Grotesk',sans-serif;
    font-weight:700; font-size:0.85rem; letter-spacing:1px; text-transform:uppercase;
    transition:all 0.2s;
  }
  .no-results a:hover { background:#fff; }

  @@keyframes fadeUp { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:translateY(0)} }

  @@media(max-width:1024px){ .stats{grid-template-columns:repeat(2,1fr);} .row2{grid-template-columns:1fr;} }
  @@media(max-width:768px){
    .menu-toggle{display:block;}
    .sidebar{position:fixed;left:0;top:0;height:100%;z-index:10;transform:translateX(-100%);}
    .sidebar.open{transform:translateX(0);}
    .sidebar-overlay.open{display:block;}
    .main{padding:20px 16px;}
    .stats{grid-template-columns:1fr 1fr;}
    .stat-val{font-size:1.5rem;}
  }
  @@media(max-width:480px){ .stats{grid-template-columns:1fr;} }
</style>
}

<div class="layout">
  <main class="main">
    <div class="topbar">
      <div style="display:flex;align-items:center;gap:12px">
        
        <div>
          <div class="greeting" id="greeting">Dobrodošao, <span>@userName</span></div>
          <div class="date-badge">@trenutniDatum</div>
        </div>
      </div>
    </div>

        @if (Model.ImaAktivnuSesiju)
        {
            <div class="active-quiz-banner">
                <div class="active-quiz-top">
                    <div>
                        <div class="active-quiz-title">Aktivna simulacija</div>
                        <div class="active-quiz-text">
                            Imaš pokrenut kviz iz predmeta <strong>@Model.AktivnaSesijaPredmetNaziv</strong>.
                            Kviz možeš nastaviti dok vrijeme ne istekne.
                        </div>
                    </div>

                    <div class="active-quiz-actions">
                        <div class="active-quiz-time">
                            <div class="active-quiz-time-label">Preostalo</div>
                            <div class="active-quiz-time-value"
                                 data-remaining-timer="@Model.AktivnaSesijaPreostaloSekundi">
                                00:00
                            </div>
                        </div>

                        <a class="active-quiz-btn"
                           asp-controller="Student"
                           asp-action="ContinueSimulation"
                           asp-route-kvizSesijaId="@Model.AktivnaSesijaId">
                            Nastavi kviz
                        </a>
                    </div>
                </div>
            </div>
        }

    <div class="stats">
      <div class="stat-card">
        <div class="stat-label">Kvizovi završeni</div>
        <div class="stat-val a">@Model.KvizoviZavrseni</div>
        @if (Model.KvizoviZavrseni == 0)
        {
          <div class="stat-trend trend-up">Započni prvi kviz!</div>
        }
        else
        {
          <div class="stat-sub">Svaka čast, samo nastavi!</div>
        }
      </div>
      <div class="stat-card">
        <div class="stat-label">Prosječan rezultat</div>
        <div class="stat-val b">@Model.ProsjecanRezultat%</div>
        @if (Model.KvizoviZavrseni == 0)
        {
          <div class="stat-sub">Još nema rezultata</div>
        }
        else
        {
          <div class="stat-sub">Prosjek svih kvizova</div>
        }
      </div>
      <div class="stat-card">
        <div class="stat-label">Rang na listi</div>
        <div class="stat-val g">@(Model.Rang.HasValue ? "#" + Model.Rang : "-")</div>
        <div class="stat-sub">od @Model.UkupnoStudenata studenata</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Nivo</div>
        <div class="stat-val">@Model.Nivo</div>
        <div class="xp-bar-wrap">
          <div class="xp-bar-bg"><div class="xp-bar-fill" style="width:@(xpPostotak)%"></div></div>
          <div class="xp-labels"><span>@Model.XpUNivou XP</span><span>@Model.XpZaNivo XP</span></div>
        </div>
      </div>
    </div>

    <div class="row2">
      <div class="section-card">
        <div class="section-title">Brze akcije</div>
        <div class="ez-quick-grid">
        <a class="ez-quick-action" asp-controller="Student" asp-action="Prepare">
          <div class="action-icon"><svg class="ui-line-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5.5c3.5-1.6 6.1-1.6 8 0v14c-1.9-1.6-4.5-1.6-8 0v-14ZM20 5.5c-3.5-1.6-6.1-1.6-8 0v14c1.9-1.6 4.5-1.6 8 0v-14Z"/></svg></div>
          <div><div class="action-text">Priprema za kviz</div><div class="action-sub">Vježbaj bez vremenskog ograničenja</div></div>
        </a>
        <a class="ez-quick-action" asp-controller="Student" asp-action="Simulate">
          <div class="action-icon amber"><svg class="ui-line-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 8v5l3 2M9 2h6M19 5l2 2"/></svg></div>
          <div><div class="action-text">Simulacija kviza</div><div class="action-sub">Realni uslovi testiranja</div></div>
        </a>
        <a class="ez-quick-action" asp-controller="Leaderboard" asp-action="Index">
          <div class="action-icon green"><svg class="ui-line-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h10v7a5 5 0 0 1-10 0V3ZM7 5H4v2a4 4 0 0 0 4 4M17 5h3v2a4 4 0 0 1-4 4M12 15v4M8 21h8M10 19h4"/></svg></div>
          <div><div class="action-text">Pogledaj rang listu</div><div class="action-sub">Trenutna pozicija: @(Model.Rang.HasValue ? "#" + Model.Rang : "-")</div></div>
        </a>
        <a class="ez-quick-action" asp-controller="Feedback" asp-action="Create">
          <div class="action-icon"><svg class="ui-line-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11.5c0 4.2-3.7 7.5-8.3 7.5-1.3 0-2.5-.3-3.6-.8L4 20l1.2-3.8a7.1 7.1 0 0 1-1.5-4.7C3.7 7.4 7.4 4 12 4s8 3.4 8 7.5Z"/></svg></div>
          <div><div class="action-text">Pošalji feedback</div><div class="action-sub">Prijedlog pitanja ili prijava greške</div></div>
        </a>
        </div>
      </div>

      <div class="section-card">
        <div class="section-title">Nedavna aktivnost</div>
        @if (!Model.NedavneAktivnosti.Any())
        {
          <div class="no-results">
            <div class="ico"><svg class="ui-line-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-8M10 14l-1 4 4-1 8-8-3-3-8 8ZM16 8l3 3"/></svg></div>
            <p>Još nema aktivnosti</p>
            <a asp-controller="Student" asp-action="Simulate">Započni prvi kviz →</a>
          </div>
        }
        else
        {
          @foreach (var akt in Model.NedavneAktivnosti)
          {
            var dotClass = akt.Procenat >= 50 ? "" : "amber";
            <div class="activity-item">
              <div class="activity-dot @dotClass"></div>
              <div class="activity-info">
                <div class="activity-name">@akt.PredmetNaziv</div>
                <div class="activity-time">@akt.Datum.ToLocalTime().ToString("dd.MM.yyyy. HH:mm")</div>
              </div>
              <div class="activity-score">@akt.Procenat%</div>
            </div>
          }
        }
      </div>
    </div>

    <div class="section-card">
      <div class="section-title">Moji predmeti</div>
      @if (!Model.MojiPredmeti.Any())
      {
        <div class="no-results">
          <div class="ico"><svg class="ui-line-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5.5c3.5-1.6 6.1-1.6 8 0v14c-1.9-1.6-4.5-1.6-8 0v-14ZM20 5.5c-3.5-1.6-6.1-1.6-8 0v14c1.9-1.6 4.5-1.6 8 0v-14Z"/></svg></div>
          <p>Još nisi radio nijedan predmet</p>
          <a asp-controller="Student" asp-action="Simulate">Odaberi predmet →</a>
        </div>
      }
      else
      {
        var boje = new[] { "var(--accent)", "var(--amber)", "var(--success)", "var(--danger)" };
        <div class="subject-list">
          @for (var i = 0; i < Model.MojiPredmeti.Count; i++)
          {
            var p = Model.MojiPredmeti[i];
            var boja = boje[i % boje.Length];
            <div class="subject-item">
              <div class="subject-ico"><svg class="ui-line-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h14v18H6a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3h13M5 17h14"/></svg></div>
              <div class="subject-info">
                <div class="subject-name">@p.Naziv</div>
                <div class="progress-bar"><div class="progress-fill" style="width:@(p.Procenat)%;background:@boja"></div></div>
              </div>
              <div class="subject-meta">
                <div class="subject-pct" style="color:@boja">@p.Procenat%</div>
                <div class="subject-count">@p.BrojPitanja pitanja</div>
              </div>
            </div>
          }
        </div>
      }
    </div>
  </main>
</div>

@section Scripts {
<script>
  // Pozdrav prema dobu dana
  (function() {
    const h = new Date().getHours();
    let pozdrav = 'Dobrodošao';
    if (h < 12) pozdrav = 'Dobro jutro';
    else if (h < 18) pozdrav = 'Dobar dan';
    else pozdrav = 'Dobro veče';
    document.getElementById('greeting').innerHTML = pozdrav + ', <span>@userName</span>';
  })();


          function formatRemainingTime(totalSeconds) {
            const minutes = Math.floor(totalSeconds / 60);
            const seconds = totalSeconds % 60;

            return minutes.toString().padStart(2, '0') + ':' +
                   seconds.toString().padStart(2, '0');
        }

        document.querySelectorAll('[data-remaining-timer]').forEach(function (timerElement) {
            let remaining = parseInt(timerElement.dataset.remainingTimer || '0');

            function render() {
                timerElement.textContent = formatRemainingTime(Math.max(remaining, 0));
            }

            render();

            const interval = setInterval(function () {
                remaining--;

                if (remaining <= 0) {
                    clearInterval(interval);
                    timerElement.textContent = 'Isteklo';
                    return;
                }

                render();
            }, 1000);
        });
</script>
}
