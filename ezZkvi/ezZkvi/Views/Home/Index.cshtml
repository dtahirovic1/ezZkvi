@{
    ViewData["Title"] = "Kvizovi iz DM i TP";
    var loggedIn = User.Identity?.IsAuthenticated == true;
    var workspaceController = User.IsInRole("Admin") ? "Administrator"
        : (User.IsInRole("Moderator") ? "Moderator" : "Student");
}

<div class="ez-landing el-refined" id="top">
    <header class="el-header">
        <nav class="el-nav" aria-label="Glavna navigacija">
            <a class="el-brand" href="#top" aria-label="ezZkvi – početna">
                <span class="el-brand-mark" aria-hidden="true"><span></span></span>
                <span>ezZkvi</span>
            </a>
            <div class="el-nav-links">
                <a href="#predmeti">Predmeti</a>
                <a href="#funkcije">Funkcije</a>
            </div>
            @if (loggedIn)
            {
                <a class="el-button el-button-primary el-header-cta" asp-controller="@workspaceController" asp-action="Dashboard">Otvori dashboard <span aria-hidden="true">↗</span></a>
            }
            else
            {
                <a class="el-button el-button-primary el-header-cta" asp-controller="Account" asp-action="Login">Prijavi se <span aria-hidden="true">↗</span></a>
            }
        </nav>
    </header>

    <main class="el-main">
        <section class="el-intro" id="predmeti" aria-labelledby="elTitle">
            <div class="el-intro-heading">
                <div class="el-kicker"><span class="el-status-dot" aria-hidden="true"></span>BAZA PITANJA ZA PRIPREMU KVIZOVA</div>
                <h1 id="elTitle">Diskretna matematika.<span>Tehnike programiranja.</span></h1>
            </div>
            <div class="el-intro-info">
                <p>ezZkvi je web aplikacija za pripremu kvizova iz ova dva predmeta na odsjeku Računarstvo i informatika Elektrotehničkog fakulteta u Sarajevu. Baza sadrži pitanja koja su se pojavljivala na kvizovima prethodnih godina.</p>
                <div class="el-intro-actions">
                    @if (loggedIn)
                    {
                        <a class="el-button el-button-primary" asp-controller="@workspaceController" asp-action="Dashboard">Otvori radni prostor <span aria-hidden="true">↗</span></a>
                    }
                    else
                    {
                        <a class="el-button el-button-primary" asp-controller="Account" asp-action="Login">Prijava <span aria-hidden="true">↗</span></a>
                    }
                    <a class="el-button el-button-secondary" href="#funkcije">Funkcije <span aria-hidden="true">↓</span></a>
                </div>
            </div>
        </section>

        <section class="el-section el-tools" id="funkcije" aria-labelledby="elToolsTitle">
            <div class="el-section-heading">
                <div><span class="el-overline"><span class="el-kicker-bar"></span>FUNKCIJE</span>
                    <h2 id="elToolsTitle">Priprema, simulacija i rezultati.</h2>
                </div>
            </div>
            <div class="el-tool-grid">
                <div class="el-tool">
                    <span class="el-tool-num">01</span><h3>Priprema</h3>
                    <p>Odaberi predmet i oblast, a zatim prolazi kroz pitanja bez vremenskog ograničenja.</p>
                </div>
                <div class="el-tool">
                    <span class="el-tool-num">02</span><h3>Simulacija kviza</h3>
                    <p>Rješavaj kviz uz ograničeno vrijeme, bodovanje i pregled odgovora.</p>
                </div>
                <div class="el-tool">
                    <span class="el-tool-num">03</span><h3>Rezultati</h3>
                    <p>Pregledaj tačne i netačne odgovore, rezultate simulacija i rang-listu.</p>
                </div>
            </div>
        </section>
    </main>
    <footer class="el-footer">
        <span>© @DateTime.Now.Year ezZkvi</span>
        <span>Nezavisna platforma za pripremu kvizova.</span>
    </footer>
</div>
