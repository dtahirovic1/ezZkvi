@model ErrorViewModel
@{
    ViewData["Title"] = "Greška";
}
<section class="ez-public-info">
    <div class="ez-public-eyebrow">SISTEM / GREŠKA</div>
    <h1>Nešto je pošlo po zlu.</h1>
    <p>Došlo je do greške pri obradi zahtjeva. Pokušaj ponovo ili se vrati na početnu stranicu.</p>
    @if (Model.ShowRequestId)
    {
        <p class="ez-public-reference">Referenca zahtjeva: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="ez-public-back">← Povratak na početnu</a>
</section>
