@model ezZkvi.Models.Odgovor

@{
    ViewData["Title"] = "Uređivanje odgovora";
}

<h1>Uređivanje odgovora</h1>

<h4>Odgovor</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Tekst" class="control-label"></label>
                <input asp-for="Tekst" class="form-control" />
                <span asp-validation-for="Tekst" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsTacan" /> @Html.DisplayNameFor(model => model.IsTacan)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="PitanjeId" class="control-label"></label>
                <select asp-for="PitanjeId" class="form-control" asp-items="ViewBag.PitanjeId"></select>
                <span asp-validation-for="PitanjeId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Sačuvaj" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Nazad na pregled</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
