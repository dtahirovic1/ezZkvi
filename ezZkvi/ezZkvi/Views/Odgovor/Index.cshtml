@model IEnumerable<ezZkvi.Models.Odgovor>

@{
    ViewData["Title"] = "Pregled odgovora";
}

<h1>Pregled odgovora</h1>

<p>
    <a asp-action="Create">Dodaj novo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Tekst)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsTacan)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pitanje)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Tekst)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsTacan)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Pitanje.Id)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Uredi</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalji</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Obriši</a>
            </td>
        </tr>
}
    </tbody>
</table>
