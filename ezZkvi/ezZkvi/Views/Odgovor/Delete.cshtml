@model ezZkvi.Models.Odgovor

@{
    ViewData["Title"] = "Brisanje odgovora";
}

<h1>Brisanje odgovora</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Odgovor</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Tekst)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Tekst)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsTacan)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsTacan)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Pitanje)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Pitanje.Id)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Obriši" class="btn btn-danger" /> |
        <a asp-action="Index">Nazad na pregled</a>
    </form>
</div>
