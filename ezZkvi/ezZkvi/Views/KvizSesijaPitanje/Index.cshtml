@model IEnumerable<ezZkvi.Models.KvizSesijaPitanje>

@{
    ViewData["Title"] = "Pregled pitanja u kvizu";
}

<h1>Pregled pitanja u kvizu</h1>

<p>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.RedniBroj)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BrojBodova)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tacno)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.RedniBroj)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BrojBodova)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tacno)
            </td>
            <td>
                <a asp-action="Details" asp-route-id="@item.ID">Detalji</a> |
            </td>
        </tr>
}
    </tbody>
</table>
