@model ezZkvi.ViewModels.PitanjeSaOdgovorimaViewModel

@{
    ViewData["Title"] = "Dodavanje pitanja";
}

<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="TekstPitanja"></label>
        <input asp-for="TekstPitanja" class="form-control" />
        <span asp-validation-for="TekstPitanja" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PredmetId">Predmet</label>
        <select asp-for="PredmetId" class="form-control" asp-items="ViewBag.PredmetId"></select>
        <span asp-validation-for="PredmetId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="OblastId">Oblast</label>
        <select asp-for="OblastId" class="form-control" asp-items="ViewBag.OblastId"></select>
        <span asp-validation-for="OblastId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Tezina"></label>
        <select asp-for="Tezina" class="form-control" asp-items="Html.GetEnumSelectList<ezZkvi.Models.Tezina>()"></select>
    </div>

    <hr />

    <div class="form-group">
        <label asp-for="Odgovor1"></label>
        <input asp-for="Odgovor1" class="form-control" />
        <label>
            <input type="radio" asp-for="TacanOdgovor" value="1" /> Tačan
        </label>
    </div>

    <div class="form-group">
        <label asp-for="Odgovor2"></label>
        <input asp-for="Odgovor2" class="form-control" />
        <label>
            <input type="radio" asp-for="TacanOdgovor" value="2" /> Tačan
        </label>
    </div>

    <div class="form-group">
        <label asp-for="Odgovor3"></label>
        <input asp-for="Odgovor3" class="form-control" />
        <label>
            <input type="radio" asp-for="TacanOdgovor" value="3" /> Tačan
        </label>
    </div>

    <div class="form-group">
        <label asp-for="Odgovor4"></label>
        <input asp-for="Odgovor4" class="form-control" />
        <label>
            <input type="radio" asp-for="TacanOdgovor" value="4" /> Tačan
        </label>
    </div>

    <span asp-validation-for="TacanOdgovor" class="text-danger"></span>

    <div class="form-group mt-3">
        <input type="submit" value="Spremi pitanje" class="btn btn-primary" />
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
