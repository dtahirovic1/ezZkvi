@model ezZkvi.Models.Pitanje

@{
    ViewData["Title"] = "Uređivanje pitanja";
}

<h1>Uređivanje pitanja</h1>

<h4>Pitanje</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="TekstPitanja" class="control-label"></label>
                <input asp-for="TekstPitanja" class="form-control" />
                <span asp-validation-for="TekstPitanja" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Tezina" class="control-label"></label>
                <select asp-for="Tezina" class="form-control" asp-items="Html.GetEnumSelectList<ezZkvi.Models.Tezina>()"></select>
                <span asp-validation-for="Tezina" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PredmetId" class="control-label"></label>
                <select asp-for="PredmetId" class="form-control" asp-items="ViewBag.PredmetId"></select>
                <span asp-validation-for="PredmetId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="OblastId" class="control-label">Oblast</label>
                <select asp-for="OblastId" class="form-control" asp-items="ViewBag.OblastId"></select>
                <span asp-validation-for="OblastId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Sačuvaj" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-controller="Content" asp-action="Index">Nazad na sadržaj</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
