@model ezZkvi.Models.Pitanje

@{
    ViewData["Title"] = "Brisanje pitanja";
}

<h1>Brisanje pitanja</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Pitanje</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TekstPitanja)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TekstPitanja)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Tezina)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Tezina)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Predmet)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Predmet.Id)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Obriši" class="btn btn-danger" /> |
        <a asp-action="Index">Nazad na pregled</a>
    </form>
</div>
