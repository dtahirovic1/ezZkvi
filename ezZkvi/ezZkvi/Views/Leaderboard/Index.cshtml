@model ezZkvi.ViewModels.LeaderboardViewModel
@{
    ViewData["Title"] = "Leaderboard";

    string PctBoja(int pct) => pct >= 80 ? "var(--success)" : (pct >= 60 ? "var(--amber)" : "var(--danger)");
}

@section Styles {
    <style>
        :root {
            --bg: #080C14;
            --surface: #0F1620;
            --card: #141D2B;
            --border: #1E2D42;
            --accent: #bfc0c3;
            --amber: #d6d6d8;
            --text: #E8EDF5;
            --muted: #5A7090;
            --success: #00E676;
            --danger: #FF5252;
            --gold: #FFD700;
            --silver: #C0C0C0;
            --bronze: #CD7F32;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'DM Sans',sans-serif;
            min-height: 100vh;
            padding: 32px 20px;
            max-width: 800px;
            margin: 0 auto;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 28px;
        }

        .page-title {
            font-family: 'Space Grotesk',sans-serif;
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: 1px;
        }

            .page-title span {
                color: var(--amber);
            }

        .page-sub {
            color: var(--muted);
            font-size: 0.85rem;
            margin-top: 4px;
        }

        .back-link {
            padding: 8px 16px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--muted);
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .back-link:hover {
                border-color: var(--accent);
                color: var(--accent);
            }

        .filters {
            display: flex;
            gap: 8px;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }

        .filter-btn {
            padding: 7px 16px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 20px;
            color: var(--muted);
            font-size: 0.82rem;
            cursor: pointer;
            transition: all 0.2s;
            font-family: 'DM Sans',sans-serif;
        }

            .filter-btn:hover, .filter-btn.active {
                border-color: var(--amber);
                color: var(--amber);
                background: rgba(255,179,0,0.07);
            }

        .sort-bar {
            display: flex;
            gap: 8px;
            margin-bottom: 16px;
            flex-wrap: wrap;
            align-items: center;
        }

        .sort-label {
            font-size: 0.75rem;
            color: var(--muted);
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-right: 4px;
        }

        .sort-btn {
            padding: 5px 12px;
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 6px;
            color: var(--muted);
            font-size: 0.75rem;
            cursor: pointer;
            transition: all 0.2s;
            font-family: 'DM Sans',sans-serif;
        }

            .sort-btn:hover, .sort-btn.active {
                border-color: var(--accent);
                color: var(--accent);
            }

        /* Podium */
        .podium {
            display: flex;
            align-items: flex-end;
            justify-content: center;
            gap: 16px;
            margin-bottom: 32px;
        }

        .podium-item {
            text-align: center;
            animation: fadeUp 0.5s ease both;
        }

            .podium-item:nth-child(1) {
                animation-delay: 0.1s;
            }

            .podium-item:nth-child(2) {
                animation-delay: 0s;
            }

            .podium-item:nth-child(3) {
                animation-delay: 0.2s;
            }

        .avatar {
            width: 54px;
            height: 54px;
            border-radius: 50%;
            margin: 0 auto 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Space Grotesk',sans-serif;
            font-size: 1.4rem;
            font-weight: 700;
            border: 3px solid var(--border);
        }

            .avatar.gold {
                border-color: var(--gold);
                background: rgba(255,215,0,0.12);
                color: var(--gold);
            }

            .avatar.silver {
                border-color: var(--silver);
                background: rgba(192,192,192,0.1);
                color: var(--silver);
            }

            .avatar.bronze {
                border-color: var(--bronze);
                background: rgba(205,127,50,0.1);
                color: var(--bronze);
            }

        .podium-name {
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .podium-score {
            font-family: 'Space Grotesk',sans-serif;
            font-size: 1.1rem;
            font-weight: 700;
        }

        .podium-block {
            border-radius: 10px 10px 0 0;
            width: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Space Grotesk',sans-serif;
            font-size: 1.5rem;
            font-weight: 700;
            margin: 10px auto 0;
        }

        .p1 {
            height: 80px;
            background: linear-gradient(180deg, rgba(255,215,0,0.2), rgba(255,215,0,0.05));
            border-top: 2px solid var(--gold);
            color: var(--gold);
        }

        .p2 {
            height: 110px;
            background: linear-gradient(180deg, rgba(255,215,0,0.25), rgba(255,215,0,0.05));
            border-top: 2px solid var(--gold);
            color: var(--gold);
        }

        .p3 {
            height: 60px;
            background: linear-gradient(180deg, rgba(205,127,50,0.2), rgba(205,127,50,0.05));
            border-top: 2px solid var(--bronze);
            color: var(--bronze);
        }

        .table-wrap {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
            animation: fadeUp 0.5s ease 0.3s both;
        }

        .table-header {
            display: grid;
            grid-template-columns: 60px 1fr 100px 100px 100px;
            padding: 12px 20px;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            font-size: 0.7rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--muted);
        }

        .table-row {
            display: grid;
            grid-template-columns: 60px 1fr 100px 100px 100px;
            padding: 14px 20px;
            border-bottom: 1px solid var(--border);
            align-items: center;
            transition: background 0.2s;
            cursor: pointer;
        }

            .table-row:last-child {
                border-bottom: none;
            }

            .table-row:hover {
                background: rgba(194,194,198,0.03);
            }

            .table-row.me {
                background: rgba(194,194,198,0.06);
                border-left: 3px solid var(--accent);
            }

        .rank {
            font-family: 'Space Grotesk',sans-serif;
            font-weight: 700;
            font-size: 1rem;
            color: var(--muted);
        }

            .rank.t1 {
                color: var(--gold);
            }

            .rank.t2 {
                color: var(--silver);
            }

            .rank.t3 {
                color: var(--bronze);
            }

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .user-av {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Space Grotesk',sans-serif;
            font-weight: 700;
            font-size: 0.85rem;
            flex-shrink: 0;
        }

        .user-n {
            font-weight: 600;
            font-size: 0.9rem;
        }

        .you-tag {
            background: rgba(194,194,198,0.15);
            color: var(--accent);
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 0.65rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-left: 6px;
        }

        .score {
            font-family: 'Space Grotesk',sans-serif;
            font-weight: 700;
            font-size: 1rem;
            color: var(--accent);
        }

        .pct {
            color: var(--success);
            font-weight: 600;
            font-size: 0.9rem;
        }

        .quizzes {
            color: var(--muted);
            font-size: 0.85rem;
        }

        .last-badge {
            font-size: 0.68rem;
            padding: 2px 8px;
            border-radius: 8px;
            margin-left: 6px;
        }

            .last-badge.good {
                background: rgba(0,230,118,0.1);
                color: var(--success);
            }

            .last-badge.ok {
                background: rgba(255,179,0,0.1);
                color: var(--amber);
            }

            .last-badge.bad {
                background: rgba(255,82,82,0.1);
                color: var(--danger);
            }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(14px)
            }

            to {
                opacity: 1;
                transform: translateY(0)
            }
        }

        @@media(max-width:600px) {
            body {
                padding: 16px;
            }

            .podium {
                flex-direction: column;
                align-items: center;
            }

            .podium-block {
                width: 200px;
            }

            .table-header, .table-row {
                grid-template-columns: 50px 1fr 80px 80px;
            }

                .table-header > :last-child, .table-row > :last-child {
                    display: none;
                }
        }
    </style>
}

<div class="page-header">
    <div>
        @{
            var backController = ViewBag.BackController as string ?? "Student";
        }
        <a class="back-link" asp-controller="@backController" asp-action="Dashboard" style="margin-bottom:12px;display:inline-flex">← Nazad</a>
        <div class="page-title"><svg class="ui-line-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h10v7a5 5 0 0 1-10 0V3ZM7 5H4v2a4 4 0 0 0 4 4M17 5h3v2a4 4 0 0 1-4 4M12 15v4M8 21h8M10 19h4"/></svg> Leader<span>board</span></div>
        <div class="page-sub">Rang lista prema tačnosti</div>
    </div>
</div>


@if (ViewBag.Predmeti != null && ViewBag.Predmeti.Count > 0)
{
    <div style="margin-bottom:16px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
        <span class="sort-label">Predmet:</span>
        <select id="predmetFilter" onchange="filterPredmet(this)"
                style="background:var(--surface);border:1px solid var(--border);border-radius:8px;color:var(--text);padding:7px 12px;font-size:0.82rem;font-family:'DM Sans',sans-serif;outline:none;cursor:pointer;">
                <option value="">Svi predmeti</option>
                @foreach (var p in ViewBag.Predmeti)
                {
                    if (ViewBag.SelectedPredmetId == p.Id)
                    {
                        <option value="@p.Id" selected>@p.Naziv</option>
                    }
                    else
                    {
                        <option value="@p.Id">@p.Naziv</option>
                    }
                }
                        </select>
                    </div>
                }

<div class="sort-bar">
    <span class="sort-label">Sortiraj:</span>
    <button class="sort-btn active" onclick="sortBy('pct', this)">Tačnost</button>
    <button class="sort-btn" onclick="sortBy('score', this)">Bodovi</button>
    <button class="sort-btn" onclick="sortBy('quizzes', this)">Kvizovi</button>
</div>

<div id="lbContent">
    @if (!Model.Entries.Any())
    {
        <div class="table-wrap" style="padding:40px;text-align:center;color:var(--muted)">
            Još nema rezultata. Uradi prvi kviz da se pojaviš na rang listi!
        </div>
    }
    else
    {
        @if (Model.Entries.Count >= 3)
        {
            <div class="podium">
                <div class="podium-item">
                    <div class="avatar silver">@Model.Entries[1].Inicijali</div>
                    <div class="podium-name">@Model.Entries[1].Ime</div>
                    <div class="podium-score" style="color:var(--silver)">@Model.Entries[1].Bodovi</div>
                    <div class="podium-block p1">2</div>
                </div>
                <div class="podium-item">
                    <div class="avatar gold">@Model.Entries[0].Inicijali</div>
                    <div class="podium-name">@Model.Entries[0].Ime</div>
                    <div class="podium-score" style="color:var(--gold)">@Model.Entries[0].Bodovi</div>
                    <div class="podium-block p2">1</div>
                </div>
                <div class="podium-item">
                    <div class="avatar bronze">@Model.Entries[2].Inicijali</div>
                    <div class="podium-name">@Model.Entries[2].Ime</div>
                    <div class="podium-score" style="color:var(--bronze)">@Model.Entries[2].Bodovi</div>
                    <div class="podium-block p3">3</div>
                </div>
            </div>
        }

        <div class="table-wrap">
            <div class="table-header">
                <span>#</span><span>Korisnik</span><span>Bodovi</span><span>Tačnost</span><span>Kvizovi</span>
            </div>
            <div id="tableBody">
                @for (var i = 0; i < Model.Entries.Count; i++)
                {
                    var e = Model.Entries[i];
                    var rankClass = i == 0 ? "t1" : (i == 1 ? "t2" : (i == 2 ? "t3" : ""));
                    <div class="table-row @(e.JeTrenutni ? "me" : "")"
                         data-score="@e.Bodovi" data-pct="@e.Tacnost" data-quizzes="@e.Kvizovi" data-name="@e.Ime">
                        <span class="rank @rankClass">@(i + 1)</span>
                        <div class="user-info">
                            <div class="user-av" style="@(e.JeTrenutni ? "background:rgba(194,194,198,0.12);color:var(--accent)" : "")">@e.Inicijali</div>
                            <span class="user-n">@e.Ime @if (e.JeTrenutni) {
                            <span class="you-tag">Ti</span>
                        }
    </span>
                    </div>
                    <span class="score">@e.Bodovi</span>
                    <span class="pct" style="color:@PctBoja(e.Tacnost)">@e.Tacnost%</span>
                    <span class="quizzes">@e.Kvizovi</span>
                </div>
            }
        </div>
    </div>
        }
</div>

@section Scripts {
    <script>
        let currentSort = 'pct';
        let lastEntries = [];
        let currentPredmetId = '';

        function filterPredmet(sel) {
          currentPredmetId = sel.value;
          refreshLeaderboard();
        }

        // Sortira kopiju liste prema trenutnom kriteriju (opadajuće)
        function applySort(entries) {
          var arr = entries.slice();
          arr.sort(function (a, b) {
            if (currentSort === 'pct') return (b.tacnost - a.tacnost) || (b.bodovi - a.bodovi) || (b.kvizovi - a.kvizovi);
            if (currentSort === 'score') return (b.bodovi - a.bodovi) || (b.tacnost - a.tacnost) || (b.kvizovi - a.kvizovi);
            if (currentSort === 'quizzes') return (b.kvizovi - a.kvizovi) || (b.tacnost - a.tacnost) || (b.bodovi - a.bodovi);
            return (b.tacnost - a.tacnost) || (b.bodovi - a.bodovi) || (b.kvizovi - a.kvizovi);
          });
          return arr;
        }

        function render() {
          var c = document.getElementById('lbContent');
          if (c) c.innerHTML = buildLeaderboardHtml(lastEntries);
        }

        function sortBy(field, btnEl) {
          currentSort = field;
          document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
          if (btnEl) btnEl.classList.add('active');
          render();
        }

        // ===== Automatsko osvježavanje (AJAX) =====
        function esc(s){ return (s==null?'':String(s)).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
        function pctBoja(p){ return p >= 80 ? 'var(--success)' : (p >= 60 ? 'var(--amber)' : 'var(--danger)'); }

        function podiumItem(cls, e, rank, block, color){
          return '<div class="podium-item">'
            + '<div class="avatar '+cls+'">'+esc(e.inicijali)+'</div>'
            + '<div class="podium-name">'+esc(e.ime)+'</div>'
            + '<div class="podium-score" style="color:'+color+'">'+e.bodovi+'</div>'
            + '<div class="podium-block '+block+'">'+rank+'</div>'
            + '</div>';
        }

        function buildLeaderboardHtml(entries){
          if (!entries || entries.length === 0){
            return '<div class="table-wrap" style="padding:40px;text-align:center;color:var(--muted)">Još nema rezultata. Uradi prvi kviz da se pojaviš na rang listi!</div>';
          }
          var sorted = applySort(entries);
          let html = '';
          if (sorted.length >= 3){
            html += '<div class="podium">'
              + podiumItem('silver', sorted[1], 2, 'p1', 'var(--silver)')
              + podiumItem('gold', sorted[0], 1, 'p2', 'var(--gold)')
              + podiumItem('bronze', sorted[2], 3, 'p3', 'var(--bronze)')
              + '</div>';
          }
          html += '<div class="table-wrap"><div class="table-header"><span>#</span><span>Korisnik</span><span>Bodovi</span><span>Tačnost</span><span>Kvizovi</span></div><div id="tableBody">';
          sorted.forEach(function(e, i){
            var rankClass = i===0?'t1':(i===1?'t2':(i===2?'t3':''));
            var meClass = e.jeTrenutni ? ' me' : '';
            var avStyle = e.jeTrenutni ? 'background:rgba(194,194,198,0.12);color:var(--accent)' : '';
            var youTag = e.jeTrenutni ? '<span class="you-tag">Ti</span>' : '';
            html += '<div class="table-row'+meClass+'" data-score="'+e.bodovi+'" data-pct="'+e.tacnost+'" data-quizzes="'+e.kvizovi+'" data-name="'+esc(e.ime)+'">'
              + '<span class="rank '+rankClass+'">'+(i+1)+'</span>'
              + '<div class="user-info"><div class="user-av" style="'+avStyle+'">'+esc(e.inicijali)+'</div>'
              + '<span class="user-n">'+esc(e.ime)+' '+youTag+'</span></div>'
              + '<span class="score">'+e.bodovi+'</span>'
              + '<span class="pct" style="color:'+pctBoja(e.tacnost)+'">'+e.tacnost+'%</span>'
              + '<span class="quizzes">'+e.kvizovi+'</span>'
              + '</div>';
          });
          html += '</div></div>';
          return html;
        }

        function refreshLeaderboard(){
          var url = '@Url.Action("Data", "Leaderboard")' + (currentPredmetId ? ('?predmetId=' + currentPredmetId) : '');
          fetch(url)
            .then(function(r){ return r.ok ? r.json() : Promise.reject(r.status); })
            .then(function(entries){
              lastEntries = entries;
              render();
            })
            .catch(function(){ /* tiho ignoriši grešku mreže */ });
        }

        // učitaj odmah, pa osvježavaj svakih 10 sekundi
        refreshLeaderboard();
        setInterval(refreshLeaderboard, 10000);
    </script>
}
