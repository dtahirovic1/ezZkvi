@model ezZkvi.Models.KvizSesija

@{
    ViewData["Title"] = "Uređivanje kviz sesije";
}

<h1>Uređivanje kviz sesije</h1>

<h4>KvizSesija</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ID" />
            <div class="form-group">
                <label asp-for="TraziBrojPitanja" class="control-label"></label>
                <input asp-for="TraziBrojPitanja" class="form-control" />
                <span asp-validation-for="TraziBrojPitanja" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="VremenskoOgranicenje" class="control-label"></label>
                <input asp-for="VremenskoOgranicenje" class="form-control" />
                <span asp-validation-for="VremenskoOgranicenje" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" class="form-control"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Sačuvaj" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Nazad na pregled</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
