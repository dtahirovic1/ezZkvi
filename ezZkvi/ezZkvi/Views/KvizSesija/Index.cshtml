@model IEnumerable<ezZkvi.Models.KvizSesija>

@{
    ViewData["Title"] = "Pregled kviz sesije";
}

<h1>Pregled kviz sesije</h1>

<p>
    <a asp-action="Create">Dodaj novo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TraziBrojPitanja)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VremenskoOgranicenje)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TraziBrojPitanja)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VremenskoOgranicenje)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ID">Uredi</a> |
                <a asp-action="Details" asp-route-id="@item.ID">Detalji</a> |
                <a asp-action="Delete" asp-route-id="@item.ID">Obriši</a>
            </td>
        </tr>
}
    </tbody>
</table>
