@{
    ViewData["Title"] = "Admin Panel";

    var userName = User.Identity?.Name ?? "Korisnik";

    // Logo vodi na dashboard prema ulozi
    var logoController = User.IsInRole("Admin") ? "Administrator" : (User.IsInRole("Moderator") ? "Moderator" : "Student");
}

@section Styles {
<style>
  :root { --bg:#080C14;--surface:#0F1620;--card:#141D2B;--border:#1E2D42;--accent:#bfc0c3;--amber:#d6d6d8;--text:#E8EDF5;--muted:#5A7090;--success:#00E676;--danger:#FF5252; }
  *{margin:0;padding:0;box-sizing:border-box;}
  body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;min-height:100vh;}
  .layout{display:flex;min-height:100vh;}

  .sidebar{width:220px;background:var(--surface);border-right:1px solid var(--border);padding:24px 0;display:flex;flex-direction:column;flex-shrink:0;transition:transform 0.3s ease;}
  .logo{font-family:'Space Grotesk',sans-serif;font-size:1.6rem;font-weight:700;letter-spacing:2px;color:var(--text);padding:0 24px 24px;border-bottom:1px solid var(--border);text-decoration:none;display:block;}
  .logo span{color:var(--accent);}
  .nav{padding:20px 12px;flex:1;}
  .nav-item{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:8px;cursor:pointer;font-size:0.9rem;color:var(--muted);margin-bottom:4px;transition:all 0.2s;text-decoration:none;position:relative;}
  .nav-item:hover,.nav-item.active{background:rgba(194,194,198,0.08);color:var(--accent);}
  .nav-item .ico{font-size:1rem;width:20px;text-align:center;}
  .badge{position:absolute;right:10px;top:50%;transform:translateY(-50%);background:var(--danger);color:white;font-size:0.65rem;width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;}
  .user-card{margin:12px;padding:12px;background:var(--card);border:1px solid var(--border);border-radius:10px;cursor:pointer;transition:all 0.2s;text-decoration:none;display:block;color:var(--text);}
  .user-card:hover{border-color:var(--accent);}
  .user-name{font-weight:600;font-size:0.9rem;}
  .user-role{font-size:0.72rem;letter-spacing:2px;color:var(--danger);text-transform:uppercase;margin-top:2px;}
  .logout-hint{font-size:0.65rem;color:var(--muted);margin-top:4px;opacity:0;transition:opacity 0.2s;}
  .user-card:hover .logout-hint{opacity:1;}

  .main{flex:1;padding:28px;overflow-y:auto;}
  .topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px;flex-wrap:wrap;gap:12px;}
  .page-title{font-family:'Space Grotesk',sans-serif;font-size:1.7rem;font-weight:700;}
  .page-title span{color:var(--accent);}
  .notif-btn{padding:9px 18px;background:var(--surface);border:1px solid var(--border);border-radius:8px;cursor:pointer;color:var(--muted);font-size:0.85rem;transition:all 0.2s;display:flex;align-items:center;gap:8px;text-decoration:none;}
  .notif-btn:hover{border-color:var(--accent);color:var(--accent);}
  .notif-dot{width:8px;height:8px;background:var(--danger);border-radius:50%;}
  .notif-dot.muted{background:var(--muted);}

  .menu-toggle{display:none;background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:8px 12px;color:var(--text);font-size:1.2rem;cursor:pointer;}

  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px;}
  .stat{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:18px 20px;animation:fadeUp 0.5s ease both;cursor:pointer;transition:all 0.2s;text-decoration:none;display:block;color:var(--text);}
  .stat:hover{border-color:var(--accent);transform:translateY(-2px);}
  .stat:nth-child(2){animation-delay:.1s}.stat:nth-child(3){animation-delay:.2s}.stat:nth-child(4){animation-delay:.3s}
  .stat-val{font-family:'Space Grotesk',sans-serif;font-size:2rem;font-weight:700;}
  .stat-label{font-size:0.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-top:3px;}
  .stat-trend{font-size:0.78rem;margin-top:6px;}
  .up{color:var(--success)}.dn{color:var(--danger)}.neu{color:var(--muted)}

  .row2{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:18px;}
  .section-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:22px;animation:fadeUp 0.5s ease 0.2s both;}
  .sec-title{font-family:'Space Grotesk',sans-serif;font-size:0.9rem;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:16px;display:flex;align-items:center;gap:8px;}
  .sec-title::before{content:'';width:3px;height:12px;background:var(--accent);border-radius:2px;}


  .item-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--border);}
  .item-row:last-child{border-bottom:none;}
  .item-name{font-size:0.88rem;font-weight:600;}
  .item-sub{font-size:0.75rem;color:var(--muted);margin-top:1px;}
  .item-val{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:0.95rem;color:var(--accent);}
  .pend-item{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--border);}
  .pend-item:last-child{border-bottom:none;}
  .av-sm{width:30px;height:30px;border-radius:50%;background:rgba(194,194,198,0.1);display:flex;align-items:center;justify-content:center;font-family:'Space Grotesk',sans-serif;font-weight:700;color:var(--accent);font-size:0.75rem;flex-shrink:0;}
  .pend-actions{display:flex;gap:6px;margin-left:auto;}
  .pa-btn{padding:4px 10px;border-radius:6px;font-size:0.72rem;cursor:pointer;border:1px solid;transition:all 0.2s;background:transparent;}
  .pa-ok{border-color:var(--success);color:var(--success);}
  .pa-ok:hover{background:rgba(0,230,118,0.08);}
  .pa-no{border-color:var(--danger);color:var(--danger);}
  .pa-no:hover{background:rgba(255,82,82,0.08);}

  .log-item{padding:9px 0;border-bottom:1px solid var(--border);display:flex;gap:10px;align-items:flex-start;}
  .log-item:last-child{border-bottom:none;}
  .log-icon{font-size:0.85rem;margin-top:1px;flex-shrink:0;}
  .log-text{font-size:0.82rem;line-height:1.4;}
  .log-time{font-size:0.72rem;color:var(--muted);margin-top:2px;}

  .toast{position:fixed;top:24px;right:24px;z-index:200;padding:12px 24px;border-radius:10px;font-size:0.85rem;font-weight:600;transform:translateX(120%);transition:transform 0.4s ease;}
  .toast.show{transform:translateX(0);}
  .toast.success{background:rgba(0,230,118,0.15);border:1px solid var(--success);color:var(--success);}
  .toast.info{background:rgba(194,194,198,0.15);border:1px solid var(--accent);color:var(--accent);}

  .sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:9;}

  @@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}

  @@media(max-width:1024px){
    .stats{grid-template-columns:repeat(2,1fr);}
    .row2{grid-template-columns:1fr;}
  }
  @@media(max-width:768px){
    .menu-toggle{display:block;}
    .sidebar{position:fixed;left:0;top:0;height:100%;z-index:10;transform:translateX(-100%);}
    .sidebar.open{transform:translateX(0);}
    .sidebar-overlay.open{display:block;}
    .main{padding:20px 16px;}
  }
  @@media(max-width:480px){
    .stats{grid-template-columns:1fr;}
  }
</style>
}

<div class="layout">
  <main class="main">
    <div class="topbar">
      <div style="display:flex;align-items:center;gap:12px">
        
        <div class="page-title">Admin <span>panel</span></div>
      </div>
      <div style="display:flex;gap:10px">
        @if (ViewBag.BrojNaCekanju > 0)
        {
          <a class="notif-btn" asp-controller="Administrator" asp-action="Users"><div class="notif-dot"></div> @ViewBag.BrojNaCekanju @(ViewBag.BrojNaCekanju == 1 ? "novi zahtjev" : "novih zahtjeva")</a>
        }
        else
        {
          <div class="notif-btn" style="cursor:default"><div class="notif-dot muted"></div> Nema novih zahtjeva</div>
        }
      </div>
    </div>

    <div class="stats">
      <a class="stat" asp-controller="Administrator" asp-action="Users">
        <div class="stat-val" style="color:var(--accent)">@ViewBag.BrojKorisnika</div>
        <div class="stat-label">Korisnika</div>
        <div class="stat-trend neu">ukupno registrovanih</div>
      </a>
      <a class="stat" asp-controller="Content" asp-action="Index">
        <div class="stat-val" style="color:var(--amber)">@ViewBag.BrojPitanja</div>
        <div class="stat-label">Pitanja u bazi</div>
        <div class="stat-trend neu">ukupno</div>
      </a>
      <div class="stat" style="cursor:default">
        <div class="stat-val" style="color:var(--success)">@ViewBag.BrojKvizova</div>
        <div class="stat-label">Kvizova završeno</div>
        <div class="stat-trend neu">ukupno</div>
      </div>
      <a class="stat" asp-controller="Feedback" asp-action="Index">
        <div class="stat-val" style="color:var(--danger)">@ViewBag.NeobradeniFeedback</div>
        <div class="stat-label">Neobrađeni feedback</div>
        <div class="stat-trend neu">čeka obradu</div>
      </a>
    </div>


    <div class="row2">
      <div class="section-card">
        <div class="sec-title">Na čekanju – Odobrenje naloga</div>
        <div id="pendingList">
          @if (ViewBag.NaCekanju == null || ViewBag.NaCekanju.Count == 0)
          {
            <div style="color:var(--muted);font-size:0.85rem;padding:8px 0;">Nema korisnika na čekanju.</div>
          }
          else
          {
            @foreach (var k in ViewBag.NaCekanju)
            {
              <div class="pend-item">
                <div class="av-sm">@k.Inicijali</div>
                <div><div style="font-size:0.88rem;font-weight:600">@k.Ime</div><div style="font-size:0.75rem;color:var(--muted)">Čeka odobrenje</div></div>
                <div class="pend-actions">
                  <form asp-controller="Administrator" asp-action="ApproveUser" asp-route-id="@k.Id" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="pa-btn pa-ok">✓</button>
                  </form>
                  <form asp-controller="Administrator" asp-action="RejectUser" asp-route-id="@k.Id" method="post" style="display:inline" onsubmit="return confirm('Odbiti i obrisati ovaj nalog?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="pa-btn pa-no">✕</button>
                  </form>
                </div>
              </div>
            }
          }
        </div>
      </div>

      <div class="section-card">
        <div class="sec-title">Najaktivniji predmeti</div>
        @if (ViewBag.NajaktivnijiPredmeti == null || ViewBag.NajaktivnijiPredmeti.Count == 0)
        {
          <div style="color:var(--muted);font-size:0.85rem;padding:8px 0;">Još nema predmeta.</div>
        }
        else
        {
          @foreach (var p in ViewBag.NajaktivnijiPredmeti)
          {
            <div class="item-row">
              <div><div class="item-name">@p.Naziv</div><div class="item-sub">@p.BrojPitanja pitanja</div></div>
              <div class="item-val">@p.BrojKvizova kvizova</div>
            </div>
          }
        }
      </div>
    </div>

    <div class="section-card">
      <div class="sec-title">Nedavna aktivnost</div>
      @if (ViewBag.NedavniKvizovi == null || ViewBag.NedavniKvizovi.Count == 0)
      {
        <div style="color:var(--muted);font-size:0.85rem;padding:8px 0;">Još nema završenih kvizova.</div>
      }
      else
      {
        @foreach (var a in ViewBag.NedavniKvizovi)
        {
          <div class="log-item">
            <span class="log-icon"><svg class="ui-line-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-8M10 14l-1 4 4-1 8-8-3-3-8 8ZM16 8l3 3"/></svg></span>
            <div>
              <div class="log-text"><strong>@a.Korisnik</strong> završio kviz iz <strong>@a.Predmet</strong> — @a.Procenat%</div>
              <div class="log-time">@a.Datum.ToLocalTime().ToString("dd.MM.yyyy. HH:mm")</div>
            </div>
          </div>
        }
      }
    </div>
  </main>
</div>

<div class="toast" id="toast"></div>

@section Scripts {
<script>


  function showToast(msg, type = 'success') {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.className = 'toast ' + type;
    setTimeout(() => t.classList.add('show'), 10);
    setTimeout(() => t.classList.remove('show'), 3500);
  }

  function approvePending(id) {
    const el = document.getElementById(id);
    if (el) {
      el.style.opacity = '0';
      el.style.transform = 'translateX(20px)';
      el.style.transition = 'all 0.3s';
      setTimeout(() => el.remove(), 300);
      showToast('Korisnik odobren!', 'success');
    }
  }

  function rejectPending(id) {
    const el = document.getElementById(id);
    if (el) {
      el.style.opacity = '0';
      el.style.transform = 'translateX(20px)';
      el.style.transition = 'all 0.3s';
      setTimeout(() => el.remove(), 300);
      showToast('Zahtjev odbijen', 'info');
    }
  }
</script>
}
