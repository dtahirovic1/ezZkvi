@model ezZkvi.ViewModels.AdminEmailObavijestViewModel

@{
    ViewData["Title"] = "Email obavijesti";
}

@section Styles {
    <style>
        :root {
            --bg: #080C14;
            --surface: #0F1620;
            --card: #141D2B;
            --border: #1E2D42;
            --accent: #bfc0c3;
            --amber: #d6d6d8;
            --text: #E8EDF5;
            --muted: #5A7090;
            --success: #00E676;
            --danger: #FF5252;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            min-height: 100vh;
            padding: 28px 24px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .page-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.7rem;
            font-weight: 700;
        }

            .page-title span {
                color: var(--accent);
            }

        .admin-badge {
            padding: 5px 14px;
            background: rgba(255,82,82,0.1);
            border: 1px solid rgba(255,82,82,0.3);
            border-radius: 20px;
            font-size: 0.72rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--danger);
        }

        .back-link {
            padding: 8px 16px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--muted);
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .back-link:hover {
                border-color: var(--accent);
                color: var(--accent);
            }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
            margin-bottom: 24px;
        }

        .stat {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 16px 20px;
        }

        .stat-val {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.8rem;
            font-weight: 700;
        }

            .stat-val.a {
                color: var(--accent);
            }

            .stat-val.g {
                color: var(--success);
            }

            .stat-val.w {
                color: var(--amber);
            }

        .stat-label {
            font-size: 0.72rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 2px;
        }

        .message-box {
            padding: 12px 16px;
            border-radius: 10px;
            margin-bottom: 16px;
            font-size: 0.88rem;
            font-weight: 600;
        }

        .message-success {
            background: rgba(0,230,118,0.1);
            border: 1px solid rgba(0,230,118,0.35);
            color: var(--success);
        }

        .message-error {
            background: rgba(255,82,82,0.1);
            border: 1px solid rgba(255,82,82,0.35);
            color: var(--danger);
        }

        .form-wrap {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
        }

        .form-header {
            padding: 14px 20px;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
        }

        .form-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.15rem;
            font-weight: 700;
        }

        .form-subtitle {
            font-size: 0.78rem;
            color: var(--muted);
            margin-top: 3px;
        }

        .form-body {
            padding: 20px;
        }

        .form-grid {
            display: grid;
            gap: 18px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .form-label {
            font-size: 0.72rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 1.6px;
            font-weight: 700;
        }

        .form-control {
            width: 100%;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 11px 14px;
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.88rem;
            outline: none;
            transition: all 0.2s;
        }

            .form-control:focus {
                border-color: var(--accent);
            }

        select.form-control {
            cursor: pointer;
        }

        textarea.form-control {
            min-height: 170px;
            resize: vertical;
            line-height: 1.5;
        }

        .hint {
            font-size: 0.78rem;
            color: var(--muted);
        }

        .text-danger {
            color: var(--danger);
            font-size: 0.78rem;
            font-weight: 600;
        }

        .form-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 14px;
            margin-top: 22px;
            padding-top: 18px;
            border-top: 1px solid var(--border);
            flex-wrap: wrap;
        }

        .footer-note {
            color: var(--muted);
            font-size: 0.8rem;
        }

        .actions {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .btn-secondary,
        .btn-primary {
            min-width: 130px;
            padding: 10px 18px;
            border-radius: 8px;
            cursor: pointer;
            font-family: 'Space Grotesk', sans-serif;
            font-size: 0.88rem;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            text-align: center;
            text-decoration: none;
            transition: all 0.2s;
        }

        .btn-secondary {
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--muted);
        }

            .btn-secondary:hover {
                border-color: var(--accent);
                color: var(--accent);
            }

        .btn-primary {
            background: var(--accent);
            border: 1px solid var(--accent);
            color: var(--bg);
        }

            .btn-primary:hover {
                background: #ffffff;
                border-color: #ffffff;
            }

        @@media(max-width:900px) {
            .stats {
                grid-template-columns: 1fr;
            }

            body {
                padding: 16px;
            }

            .form-footer {
                align-items: stretch;
            }

            .actions {
                width: 100%;
                flex-direction: column-reverse;
            }

            .btn-secondary,
            .btn-primary {
                width: 100%;
            }
        }
    </style>
}

<div class="topbar">
    <div style="display:flex;align-items:center;gap:12px">
        <a class="back-link" asp-controller="Administrator" asp-action="Dashboard">Nazad</a>
        <div>
            <div class="page-title">Email <span>obavijesti</span></div>
            <div style="font-size:0.8rem;color:var(--muted);margin-top:2px;">
                Slanje sistemskih email obavijesti korisnicima
            </div>
        </div>
    </div>

    <div class="admin-badge">Admin</div>
</div>

@if (TempData["Message"] != null)
{
    <div class="message-box message-success">
        @TempData["Message"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="message-box message-error">
        @TempData["Error"]
    </div>
}

<div class="form-wrap">
    <div class="form-header">
        <div class="form-title">Nova email obavijest</div>
        <div class="form-subtitle">
            Odaberi grupu primalaca, unesi naslov i sadržaj poruke.
        </div>
    </div>

    <div class="form-body">
        <form asp-controller="Administrator" asp-action="EmailObavijest" method="post">
            @Html.AntiForgeryToken()

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="Primaoci" class="form-label">Primaoci</label>

                    <select asp-for="Primaoci" class="form-control">
                        <option value="Studenti">Samo studenti</option>
                        <option value="AdminiModeratori">Admini i moderatori</option>
                    </select>

                    <span asp-validation-for="Primaoci" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Naslov" class="form-label">Naslov</label>
                    <input asp-for="Naslov"
                           class="form-control"
                           placeholder="npr. Obavijest o održavanju sistema" />
                    <span asp-validation-for="Naslov" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Poruka" class="form-label">Poruka</label>
                    <textarea asp-for="Poruka"
                              class="form-control"
                              placeholder="Unesite sadržaj email obavijesti..."></textarea>
                    <span asp-validation-for="Poruka" class="text-danger"></span>
                </div>
            </div>

            <div class="form-footer">
                <div class="footer-note">
                    Mail se šalje korisnicima koji imaju registrovanu email adresu.
                </div>

                <div class="actions">
                    <a class="btn-secondary" asp-controller="Administrator" asp-action="Dashboard">
                        Odustani
                    </a>

                    <button type="submit" class="btn-primary">
                        Pošalji
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}