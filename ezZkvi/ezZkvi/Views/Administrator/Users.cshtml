@model List<ezZkvi.ViewModels.AdminUserViewModel>

@{
    ViewData["Title"] = "Upravljanje korisnicima";

    var totalUsers = Model.Count;
    var activeUsers = Model.Count(u => u.IsActive);
    var pendingUsers = Model.Count(u => !u.IsApproved);
    var adminUsers = Model.Count(u => !string.IsNullOrWhiteSpace(u.Role) && u.Role.Contains("Admin"));

    string GetInitials(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return "US";

        var namePart = email.Split('@')[0];
        var parts = namePart.Split(new[] { '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length >= 2)
            return (parts[0][0].ToString() + parts[1][0].ToString()).ToUpper();

        if (namePart.Length >= 2)
            return namePart.Substring(0, 2).ToUpper();

        return namePart.ToUpper();
    }

    string GetRoleText(string role)
    {
        if (string.IsNullOrWhiteSpace(role))
            return "Nema ulogu";

        if (role.Contains("Admin"))
            return "Admin";

        if (role.Contains("Moderator"))
            return "Moderator";

        if (role.Contains("Student"))
            return "Student";

        return role;
    }

    string GetAvatarClass(string role)
    {
        role = GetRoleText(role);

        if (role == "Admin")
            return "admin";

        if (role == "Moderator")
            return "mod";

        return "student";
    }

    string GetRoleClass(string role)
    {
        role = GetRoleText(role);

        if (role == "Admin")
            return "role-admin";

        if (role == "Moderator")
            return "role-mod";

        return "role-student";
    }
}

@section Styles {
    <style>
        :root {
            --bg: #080C14;
            --surface: #0F1620;
            --card: #141D2B;
            --border: #1E2D42;
            --accent: #bfc0c3;
            --amber: #d6d6d8;
            --text: #E8EDF5;
            --muted: #5A7090;
            --success: #00E676;
            --danger: #FF5252;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            min-height: 100vh;
            padding: 28px 24px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .page-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.7rem;
            font-weight: 700;
        }

            .page-title span {
                color: var(--accent);
            }

        .admin-badge {
            padding: 5px 14px;
            background: rgba(255,82,82,0.1);
            border: 1px solid rgba(255,82,82,0.3);
            border-radius: 20px;
            font-size: 0.72rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--danger);
        }

        .back-link {
            padding: 8px 16px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--muted);
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .back-link:hover {
                border-color: var(--accent);
                color: var(--accent);
            }

        .stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px;
            margin-bottom: 24px;
        }

        .stat {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 16px 20px;
        }

        .stat-val {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.8rem;
            font-weight: 700;
        }

            .stat-val.a {
                color: var(--accent);
            }

            .stat-val.g {
                color: var(--success);
            }

            .stat-val.w {
                color: var(--amber);
            }

            .stat-val.r {
                color: var(--danger);
            }

        .stat-label {
            font-size: 0.72rem;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 2px;
        }

        .toolbar {
            display: flex;
            gap: 10px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }

        .search-wrap {
            position: relative;
            flex: 1;
            min-width: 200px;
        }

            .search-wrap input {
                width: 100%;
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 10px 14px 10px 36px;
                color: var(--text);
                font-family: 'DM Sans', sans-serif;
                font-size: 0.88rem;
                outline: none;
            }

                .search-wrap input:focus {
                    border-color: var(--accent);
                }

        .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
            font-size: 0.85rem;
        }

        select {
            padding: 9px 14px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--muted);
            font-size: 0.85rem;
            outline: none;
            cursor: pointer;
            font-family: 'DM Sans', sans-serif;
        }

            select:focus {
                border-color: var(--accent);
            }

        .message-box {
            padding: 12px 16px;
            border-radius: 10px;
            margin-bottom: 16px;
            font-size: 0.88rem;
            font-weight: 600;
        }

        .message-success {
            background: rgba(0,230,118,0.1);
            border: 1px solid rgba(0,230,118,0.35);
            color: var(--success);
        }

        .message-error {
            background: rgba(255,82,82,0.1);
            border: 1px solid rgba(255,82,82,0.35);
            color: var(--danger);
        }

        .table-wrap {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
        }

        .t-header {
            display: grid;
            grid-template-columns: 1fr 130px 130px 320px;
            padding: 12px 20px;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            font-size: 0.7rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--muted);
        }

            .t-header span:nth-child(2),
            .t-header span:nth-child(3),
            .t-header span:nth-child(4) {
                text-align: center;
            }

        .t-row {
            display: grid;
            grid-template-columns: 1fr 130px 130px 320px;
            padding: 13px 20px;
            border-bottom: 1px solid var(--border);
            align-items: center;
            transition: background 0.2s;
            min-height: 72px;
        }

            .t-row:last-child {
                border-bottom: none;
            }

            .t-row:hover {
                background: rgba(255,255,255,0.02);
            }

            .t-row > span:nth-child(2),
            .t-row > span:nth-child(3) {
                justify-self: center;
            }

        .user-cell {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

        .av {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: var(--border);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            font-size: 0.8rem;
            flex-shrink: 0;
        }

            .av.student {
                background: rgba(194,194,198,0.1);
                color: var(--accent);
            }

            .av.mod {
                background: rgba(255,179,0,0.1);
                color: var(--amber);
            }

            .av.admin {
                background: rgba(255,82,82,0.1);
                color: var(--danger);
            }

        .u-name {
            font-weight: 600;
            font-size: 0.88rem;
            word-break: break-word;
        }

        .u-email {
            font-size: 0.75rem;
            color: var(--muted);
            word-break: break-word;
        }

        .role-tag {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 74px;
            padding: 3px 10px;
            border-radius: 10px;
            font-size: 0.72rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            font-weight: 600;
            text-align: center;
        }

        .role-student {
            background: rgba(194,194,198,0.1);
            color: var(--accent);
        }

        .role-mod {
            background: rgba(255,179,0,0.1);
            color: var(--amber);
        }

        .role-admin {
            background: rgba(255,82,82,0.1);
            color: var(--danger);
        }

        .status-tag {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 76px;
            padding: 3px 10px;
            border-radius: 10px;
            font-size: 0.72rem;
            transition: all 0.2s;
            text-align: center;
        }

        .status-active {
            background: rgba(0,230,118,0.1);
            color: var(--success);
        }

        .status-pending {
            background: rgba(255,179,0,0.1);
            color: var(--amber);
        }

        .status-inactive {
            background: rgba(90,112,144,0.1);
            color: var(--muted);
        }

        .actions-cell {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .action-row {
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .action-form {
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        .role-form {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin: 0;
        }

        .role-select {
            width: 112px;
            height: 32px;
            padding: 0 10px;
            border-radius: 7px;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--muted);
            font-size: 0.75rem;
            outline: none;
            font-family: 'DM Sans', sans-serif;
        }

            .role-select:focus {
                border-color: var(--accent);
            }

        .act-btn {
            min-width: 96px;
            height: 32px;
            padding: 0 10px;
            border-radius: 7px;
            cursor: pointer;
            font-size: 0.72rem;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--muted);
            transition: all 0.2s;
            white-space: nowrap;
            font-family: 'DM Sans', sans-serif;
        }

            .act-btn.approve:hover {
                border-color: var(--success);
                color: var(--success);
            }

            .act-btn.reject:hover {
                border-color: var(--danger);
                color: var(--danger);
            }

            .act-btn.remove:hover {
                border-color: var(--amber);
                color: var(--amber);
            }

        .action-note {
            font-size: 0.75rem;
            color: var(--muted);
            text-align: center;
        }

        .empty-state {
            padding: 30px 20px;
            text-align: center;
            color: var(--muted);
            font-size: 0.9rem;
        }

        @@media(max-width: 1000px) {
            .t-header {
                grid-template-columns: 1fr 110px 110px 280px;
            }

            .t-row {
                grid-template-columns: 1fr 110px 110px 280px;
            }

            .role-form {
                flex-direction: column;
                gap: 6px;
            }

            .role-select,
            .act-btn {
                width: 120px;
            }
        }

        @@media(max-width: 900px) {
            .stats {
                grid-template-columns: repeat(2, 1fr);
            }

            body {
                padding: 16px;
            }

            .t-header {
                display: none;
            }

            .t-row {
                grid-template-columns: 1fr;
                gap: 12px;
                padding: 16px;
            }

                .t-row > span:nth-child(2),
                .t-row > span:nth-child(3) {
                    justify-self: start;
                }

            .actions-cell {
                align-items: flex-start;
            }

            .action-row {
                justify-content: flex-start;
            }

            .role-form {
                flex-direction: row;
                flex-wrap: wrap;
                justify-content: flex-start;
            }
        }

        @@media(max-width: 560px) {
            .stats {
                grid-template-columns: 1fr;
            }

            .topbar > div:first-child {
                flex-direction: column;
                align-items: flex-start !important;
            }

            .toolbar {
                flex-direction: column;
            }

            .search-wrap {
                width: 100%;
            }

            .toolbar select {
                width: 100%;
            }

            .role-form {
                width: 100%;
            }

            .role-select,
            .act-btn {
                width: 100%;
            }

            .action-row {
                width: 100%;
                flex-direction: column;
            }

            .action-form {
                width: 100%;
            }
        }
    </style>
}

<div class="topbar">
    <div style="display:flex;align-items:center;gap:12px">
        <a class="back-link" asp-controller="Administrator" asp-action="Dashboard">Nazad</a>
        <div>
            <div class="page-title">Upravljanje <span>korisnicima</span></div>
            <div style="font-size:0.8rem;color:var(--muted);margin-top:2px;">
                Odobravanje registracija i upravljanje pristupom
            </div>
        </div>
    </div>

    <div class="admin-badge">Admin</div>
</div>

@if (TempData["Message"] != null)
{
    <div class="message-box message-success">
        @TempData["Message"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="message-box message-error">
        @TempData["Error"]
    </div>
}

<div class="stats">
    <div class="stat">
        <div class="stat-val a" id="statTotal">@totalUsers</div>
        <div class="stat-label">Ukupno korisnika</div>
    </div>

    <div class="stat">
        <div class="stat-val g" id="statActive">@activeUsers</div>
        <div class="stat-label">Aktivnih</div>
    </div>

    <div class="stat">
        <div class="stat-val w" id="statPending">@pendingUsers</div>
        <div class="stat-label">Na čekanju</div>
    </div>

    <div class="stat">
        <div class="stat-val r" id="statAdmins">@adminUsers</div>
        <div class="stat-label">Admina</div>
    </div>
</div>

<div class="toolbar">
    <div class="search-wrap">
        <span class="search-icon">⌕</span>
        <input type="text" id="userSearch" placeholder="Pretraži korisnike..." oninput="filterUsers()">
    </div>

    <select id="roleFilter" onchange="filterUsers()">
        <option value="">Sve uloge</option>
        <option value="Student">Student</option>
        <option value="Moderator">Moderator</option>
        <option value="Admin">Admin</option>
        <option value="Nema ulogu">Nema ulogu</option>
    </select>

    <select id="statusFilter" onchange="filterUsers()">
        <option value="">Svi statusi</option>
        <option value="Aktivan">Aktivan</option>
        <option value="Neaktivan">Neaktivan</option>
        <option value="Na čekanju">Na čekanju</option>
    </select>
</div>

<div class="table-wrap" id="userTable">
    <div class="t-header">
        <span>Korisnik</span>
        <span>Uloga</span>
        <span>Status</span>
        <span>Akcije</span>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            Nema korisnika za prikaz.
        </div>
    }
    else
    {
        foreach (var user in Model)
        {
            var roleText = GetRoleText(user.Role);
            var statusText = !user.IsApproved ? "Na čekanju" : (user.IsActive ? "Aktivan" : "Neaktivan");
            var initials = GetInitials(user.Email);
            var avatarClass = GetAvatarClass(user.Role);
            var roleClass = GetRoleClass(user.Role);

            <div class="t-row" data-role="@roleText" data-status="@statusText">
                <div class="user-cell">
                    <div class="av @avatarClass">@initials</div>
                    <div>
                        <div class="u-name">@user.Email</div>
                        <div class="u-email">@user.Email</div>
                    </div>
                </div>

                <span>
                    <span class="role-tag @roleClass">@roleText</span>
                </span>

                <span>
                    @if (!user.IsApproved)
                    {
                        <span class="status-tag status-pending">Na čekanju</span>
                    }
                    else if (user.IsActive)
                    {
                        <span class="status-tag status-active">Aktivan</span>
                    }
                    else
                    {
                        <span class="status-tag status-inactive">Neaktivan</span>
                    }
                </span>

                <div class="actions-cell">
                    @if (!user.IsApproved)
                    {
                        <div class="action-row">
                            <form class="action-form" asp-controller="Administrator" asp-action="ApproveUser" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="act-btn approve">Odobri</button>
                            </form>

                            <form class="action-form" asp-controller="Administrator" asp-action="RejectUser" method="post" onsubmit="return confirm('Da li želite odbiti ovog korisnika?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="act-btn reject">Odbij</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="action-row">
                            <form class="role-form" asp-controller="Administrator" asp-action="ChangeRole" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />

                                <select name="role" class="role-select">
                                    @foreach (var roleOption in new[] { "Student", "Moderator", "Admin" })
                                    {
                                        if (roleText == roleOption)
                                        {
                                            <option value="@roleOption" selected>@roleOption</option>
                                        }
                                        else
                                        {
                                            <option value="@roleOption">@roleOption</option>
                                        }
                                    }
                                </select>

                                <button type="submit" class="act-btn approve">Spasi ulogu</button>
                            </form>
                        </div>

                        <div class="action-row">
                            @if (roleText != "Admin")
                            {
                                <form class="action-form" asp-controller="Administrator" asp-action="RemoveAccess" method="post" onsubmit="return confirm('Da li želite ukloniti pristup ovom korisniku?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="act-btn remove">Ukloni pristup</button>
                                </form>
                            }
                            else
                            {
                                <span class="action-note">Admin nalog</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        function filterUsers() {
            const search = document.getElementById('userSearch').value.toLowerCase();
            const role = document.getElementById('roleFilter').value;
            const status = document.getElementById('statusFilter').value;

            document.querySelectorAll('#userTable .t-row').forEach(row => {
                const text = row.textContent.toLowerCase();
                const rowRole = row.getAttribute('data-role');
                const rowStatus = row.getAttribute('data-status');

                const show =
                    (!search || text.includes(search)) &&
                    (!role || rowRole === role) &&
                    (!status || rowStatus === status);

                row.style.display = show ? '' : 'none';
            });
        }
    </script>
}