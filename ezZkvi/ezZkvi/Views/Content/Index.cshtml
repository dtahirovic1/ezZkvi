@model IEnumerable<ezZkvi.Models.Pitanje>
@using ezZkvi.Models
@using System.Collections.Generic

@{
    ViewData["Title"] = "Upravljanje sadržajem";

    var roleText = User.IsInRole("Admin") ? "Admin" : "Moderator";
    var backController = User.IsInRole("Admin") ? "Administrator" : "Moderator";
    var activeTab = (ViewData["ActiveTab"]?.ToString() ?? "questions").ToLowerInvariant();
    var odgovoriPoPitanju = ViewBag.OdgovoriPoPitanju as Dictionary<int, List<Odgovor>> ?? new Dictionary<int, List<Odgovor>>();
}

@section Styles {
    <style>
        :root {
            --bg: #080C14;
            --surface: #0F1620;
            --card: #141D2B;
            --border: #1E2D42;
            --accent: #bfc0c3;
            --amber: #d6d6d8;
            --text: #E8EDF5;
            --muted: #5A7090;
            --success: #00E676;
            --danger: #FF5252;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'DM Sans',sans-serif;
            min-height: 100vh;
            padding: 28px 24px;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .page-title {
            font-family: 'Space Grotesk',sans-serif;
            font-size: 1.7rem;
            font-weight: 700;
            letter-spacing: 1px;
        }

            .page-title span {
                color: var(--accent);
            }

        .role-badge {
            padding: 5px 14px;
            background: rgba(194,194,198,0.1);
            border: 1px solid rgba(194,194,198,0.3);
            border-radius: 20px;
            font-size: 0.72rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--accent);
        }

        .back-link {
            padding: 8px 16px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--muted);
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .back-link:hover {
                border-color: var(--accent);
                color: var(--accent);
            }

        .tabs {
            display: flex;
            gap: 4px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 4px;
            margin-bottom: 24px;
            width: fit-content;
        }

        .tab {
            padding: 9px 22px;
            border-radius: 7px;
            cursor: pointer;
            font-family: 'Space Grotesk',sans-serif;
            font-size: 0.9rem;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--muted);
            transition: all 0.2s;
            border: none;
            background: transparent;
        }

            .tab.active {
                background: var(--accent);
                color: var(--bg);
            }

        .toolbar {
            display: flex;
            gap: 10px;
            margin-bottom: 16px;
            flex-wrap: wrap;
            align-items: center;
        }

        .search-wrap {
            position: relative;
            flex: 1;
            min-width: 220px;
        }

            .search-wrap input {
                width: 100%;
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 10px 14px 10px 36px;
                color: var(--text);
                font-family: 'DM Sans',sans-serif;
                font-size: 0.88rem;
                outline: none;
            }

                .search-wrap input:focus {
                    border-color: var(--accent);
                }

        .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
            font-size: 0.9rem;
        }

        select {
            padding: 9px 14px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--muted);
            font-size: 0.85rem;
            outline: none;
            cursor: pointer;
            font-family: 'DM Sans',sans-serif;
        }

            select:focus {
                border-color: var(--accent);
            }

        .btn-add {
            padding: 9px 20px;
            background: var(--accent);
            color: var(--bg);
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-family: 'Space Grotesk',sans-serif;
            font-weight: 700;
            font-size: 0.9rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
        }

            .btn-add:hover {
                background: #fff;
                box-shadow: 0 0 16px rgba(194,194,198,0.4);
                color: var(--bg);
            }

        .table-wrap {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
        }

        .t-header {
            display: grid;
            grid-template-columns: minmax(0, 1.8fr) minmax(150px, 220px) minmax(170px, 260px) 100px 120px;
            padding: 12px 20px;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            font-size: 0.7rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--muted);
        }

        .t-row {
            display: grid;
            grid-template-columns: minmax(0, 1.8fr) minmax(150px, 220px) minmax(170px, 260px) 100px 120px;
            padding: 14px 20px;
            border-bottom: 1px solid var(--border);
            align-items: center;
            transition: background 0.2s;
        }

            .t-row:last-child {
                border-bottom: none;
            }

            .t-row:hover {
                background: rgba(194,194,198,0.03);
            }

        .q-text-cell {
            font-size: 0.88rem;
            font-weight: 600;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            padding-right: 12px;
        }

        .tag {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            max-width: 100%;
            padding: 4px 10px;
            border-radius: 10px;
            font-size: 0.68rem;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            background: rgba(194,194,198,0.1);
            color: var(--accent);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            text-align: center;
            line-height: 1.2;
        }

        .center-cell {
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 0;
            padding-right: 12px;
        }

        .subject-tag {
            width: fit-content;
            max-width: min(100%, 260px);
        }

        .diff {
            font-size: 0.78rem;
            font-weight: 800;
            text-transform: uppercase;
        }

        .diff-easy {
            color: var(--success);
        }

        .diff-med {
            color: var(--amber);
        }

        .diff-hard {
            color: var(--danger);
        }

        .actions-cell {
            display: flex;
            gap: 8px;
            align-items: center;
            justify-content: flex-start;
        }

        .act-btn {
            min-width: 52px;
            padding: 6px 10px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.74rem;
            border: 1px solid var(--border);
            background: var(--surface);
            color: var(--muted);
            transition: all 0.2s;
            text-decoration: none;
            font-family: 'DM Sans',sans-serif;
            text-align: center;
        }

            .act-btn.edit:hover {
                border-color: var(--accent);
                color: var(--accent);
            }

            .act-btn.del:hover {
                border-color: var(--danger);
                color: var(--danger);
            }

        .panel {
            display: none;
        }

            .panel.active {
                display: block;
            }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.72);
            z-index: 100;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

            .modal-overlay.open {
                display: flex;
            }

        .modal {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 30px;
            width: 100%;
            max-width: 560px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 70px rgba(0,0,0,0.45);
            animation: fadeUp 0.25s ease both;
        }

        .modal-title {
            font-family: 'Space Grotesk',sans-serif;
            font-size: 1.35rem;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-close {
            background: transparent;
            border: none;
            color: var(--muted);
            font-size: 1.5rem;
            cursor: pointer;
        }

            .modal-close:hover {
                color: var(--danger);
            }

        .form-group {
            margin-bottom: 16px;
        }

            .form-group label {
                display: block;
                font-size: 0.72rem;
                letter-spacing: 2px;
                text-transform: uppercase;
                color: var(--muted);
                margin-bottom: 6px;
            }

        .form-control-dark {
            width: 100%;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px 14px;
            color: var(--text);
            font-family: 'DM Sans',sans-serif;
            font-size: 0.88rem;
            outline: none;
        }

            .form-control-dark:focus {
                border-color: var(--accent);
            }

        textarea.form-control-dark {
            min-height: 90px;
            resize: vertical;
        }

        .answers-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .answer-box {
            position: relative;
        }

            .answer-box span {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                font-family: 'Space Grotesk',sans-serif;
                font-weight: 700;
                color: var(--muted);
            }

            .answer-box input {
                padding-left: 36px;
            }

        .modal-two-cols {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 24px;
        }

        .btn-cancel {
            padding: 10px 20px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--muted);
            cursor: pointer;
            font-family: 'Space Grotesk',sans-serif;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .btn-save {
            padding: 10px 24px;
            background: var(--accent);
            color: var(--bg);
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-family: 'Space Grotesk',sans-serif;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

            .btn-save:hover {
                background: #fff;
            }

        .toast {
            position: fixed;
            top: 24px;
            right: 24px;
            z-index: 200;
            padding: 12px 24px;
            border-radius: 10px;
            font-size: 0.85rem;
            font-weight: 600;
            transform: translateX(120%);
            transition: transform 0.4s ease;
        }

            .toast.show {
                transform: translateX(0);
            }

            .toast.success {
                background: rgba(0,230,118,0.15);
                border: 1px solid var(--success);
                color: var(--success);
            }

            .toast.error {
                background: rgba(255,82,82,0.15);
                border: 1px solid var(--danger);
                color: var(--danger);
            }

        @@keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media(max-width:768px) {
            body {
                padding: 16px;
            }

            .t-header,
            .t-row {
                grid-template-columns: 1fr 90px 100px;
            }

                .t-header > :nth-child(3),
                .t-row > :nth-child(3) {
                    display: none;
                }

            .answers-grid,
            .modal-two-cols {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="topbar">
    <div style="display:flex;align-items:center;gap:12px">
        <a class="back-link" asp-controller="@backController" asp-action="Dashboard">← Nazad</a>

        <div>
            <div class="page-title">Upravljanje <span>sadržajem</span></div>
            <div style="font-size:0.8rem;color:var(--muted);margin-top:2px;">
                Pitanja, oblasti i predmeti platforme
            </div>
        </div>
    </div>

    <div class="role-badge">@roleText</div>
</div>

<div class="tabs">
    <button type="button" class="tab @(activeTab == "questions" ? "active" : "")" data-tab="questions" onclick="switchTab('questions')">Pitanja</button>
    <button type="button" class="tab @(activeTab == "areas" ? "active" : "")" data-tab="areas" onclick="switchTab('areas')">Oblasti</button>
    <button type="button" class="tab @(activeTab == "subjects" ? "active" : "")" data-tab="subjects" onclick="switchTab('subjects')">Predmeti</button>
</div>

<div class="panel @(activeTab == "questions" ? "active" : "")" id="questions">
    <form class="toolbar" id="filterForm" onsubmit="return false;">
        <div class="search-wrap">
            <span class="search-icon">⌕</span>
            <input type="text" id="questionSearchInput" placeholder="Pretraži pitanja..." autocomplete="off">
        </div>

        <select id="questionPredmetFilter" asp-items="ViewBag.Predmeti">
            <option value="">Svi predmeti</option>
        </select>

        <select id="questionOblastFilter">
            <option value="">Sve oblasti</option>
            @foreach (var o in ViewBag.OblastiListaZaSelect)
            {
                <option value="@o.Id" data-predmet-id="@o.PredmetId">@o.PredmetNaziv / @o.Naziv</option>
            }
        </select>

        <select id="tezinaFilter">
            <option value="">Sve težine</option>
            <option value="LAKO">Lako</option>
            <option value="SREDNJE">Srednje</option>
            <option value="TESKO">Teško</option>
        </select>

        <button type="button" class="btn-add" onclick="openQuestionModal()">
            + Dodaj pitanje
        </button>

        <button type="button" class="btn-add" style="background:var(--surface);color:var(--accent);border:1px solid var(--accent)" onclick="openCsvModal()">
            ⇄ CSV
        </button>
    </form>

@if (User.IsInRole("Admin")) {
<div class="question-statistics" id="filteredQuestionStatistics" aria-live="polite"></div>
}
@if (User.IsInRole("Admin")) {
    <form asp-controller="Content" asp-action="BulkDelete" method="post" class="bulk-toolbar" data-bulk-kind="questions">
        @Html.AntiForgeryToken()
        <input type="hidden" name="kind" value="questions"><input type="hidden" name="confirmed" value="true">
        <label><input type="checkbox" class="bulk-all"> Označi sve prikazane</label>
        <span class="bulk-count">Odabrano: 0</span>
        <button type="submit" class="act-btn del" disabled>Obriši odabrana pitanja</button>
    </form>
}
    <div class="table-wrap" id="questionTable">
        <div class="t-header">
            <span>Pitanje</span>
            <span>Oblast</span>
            <span>Predmet</span>
            <span>Težina</span>
            <span>Akcije</span>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="t-row" style="grid-template-columns:1fr;">
                <div class="q-text-cell">Nema pitanja u bazi.</div>
            </div>
        }
        else
        {
            @foreach (var pitanje in Model)
            {
                var tezinaClass = pitanje.Tezina == Tezina.LAKO
                ? "diff-easy"
                : pitanje.Tezina == Tezina.SREDNJE
                ? "diff-med"
                : "diff-hard";

                odgovoriPoPitanju.TryGetValue(pitanje.Id, out var odgovori);
                odgovori ??= new List<Odgovor>();
                var odgovor1 = odgovori.ElementAtOrDefault(0);
                var odgovor2 = odgovori.ElementAtOrDefault(1);
                var odgovor3 = odgovori.ElementAtOrDefault(2);
                var odgovor4 = odgovori.ElementAtOrDefault(3);
                var tacanOdgovor = odgovor1?.IsTacan == true ? 1
                    : odgovor2?.IsTacan == true ? 2
                    : odgovor3?.IsTacan == true ? 3
                    : odgovor4?.IsTacan == true ? 4
                    : 1;

                <div class="t-row question-row"
                     data-search="@((pitanje.TekstPitanja + " " + (pitanje.Oblast != null ? pitanje.Oblast.Naziv : "") + " " + (pitanje.Predmet != null ? pitanje.Predmet.Naziv : "")).ToLowerInvariant())"
                     data-predmet-id="@pitanje.PredmetId"
                     data-oblast-id="@pitanje.OblastId"
                     data-tezina="@pitanje.Tezina">
                    <div>
                        @if (User.IsInRole("Admin")) { <input type="checkbox" class="bulk-check" data-kind="questions" value="@pitanje.Id" aria-label="Odaberi pitanje" /> }
                        <div class="q-text-cell">@pitanje.TekstPitanja</div>
                    </div>

                    <span class="center-cell">
                        <span class="tag subject-tag" title='@(pitanje.Oblast != null ? pitanje.Oblast.Naziv : "Bez oblasti")' style="background:rgba(255,179,0,0.1);color:var(--amber);">
                            @(pitanje.Oblast != null ? pitanje.Oblast.Naziv : "Bez oblasti")
                        </span>
                    </span>

                    <span class="center-cell">
                        <span class="tag subject-tag" title='@(pitanje.Predmet != null ? pitanje.Predmet.Naziv : "Bez predmeta")'>
                            @(pitanje.Predmet != null ? pitanje.Predmet.Naziv : "Bez predmeta")
                        </span>
                    </span>

                    <span class="diff @tezinaClass">
                        @DifficultyNames.Display(pitanje.Tezina)
                    </span>

                    <div class="actions-cell">
                        <button type="button"
                                class="act-btn edit"
                                data-id="@pitanje.Id"
                                data-tekst="@pitanje.TekstPitanja"
                                data-predmet-id="@pitanje.PredmetId"
                                data-oblast-id="@pitanje.OblastId"
                                data-tezina="@pitanje.Tezina"
                                data-odgovor1="@(odgovor1?.Tekst ?? string.Empty)"
                                data-odgovor2="@(odgovor2?.Tekst ?? string.Empty)"
                                data-odgovor3="@(odgovor3?.Tekst ?? string.Empty)"
                                data-odgovor4="@(odgovor4?.Tekst ?? string.Empty)"
                                data-tacan-odgovor="@tacanOdgovor"
                                onclick="openEditQuestion(this)">
                            Uredi
                        </button>

                        <form asp-controller="Pitanje"
                              asp-action="Delete"
                              asp-route-id="@pitanje.Id"
                              method="post"
                              style="display:inline;"
                              onsubmit="return confirm('Da li ste sigurni da želite obrisati ovo pitanje?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="act-btn del">Obriši</button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>

<div class="panel @(activeTab == "subjects" ? "active" : "")" id="subjects">
    <form class="toolbar" id="subjectFilterForm" onsubmit="return false;">
        <div class="search-wrap">
            <span class="search-icon">⌕</span>
            <input type="text" id="subjectSearchInput" placeholder="Pretraži predmete..." autocomplete="off">
        </div>


        <button type="button" class="btn-add" onclick="openSubjectModal()">
            + Novi predmet
        </button>
    </form>

@if (User.IsInRole("Admin")) {
    <form asp-controller="Content" asp-action="BulkDelete" method="post" class="bulk-toolbar" data-bulk-kind="subjects">
        @Html.AntiForgeryToken()
        <input type="hidden" name="kind" value="subjects"><input type="hidden" name="confirmed" value="true">
        <label><input type="checkbox" class="bulk-all"> Označi sve prikazane</label>
        <span class="bulk-count">Odabrano: 0</span>
        <button type="submit" class="act-btn del" disabled>Obriši odabrane predmete</button>
    </form>
}
    <div class="table-wrap">
        <div class="t-header" style="grid-template-columns:1fr 90px 140px">
            <span>Naziv predmeta</span>
            <span>Pitanja</span>
            <span>Akcije</span>
        </div>

        @if (ViewBag.PredmetiLista == null || ViewBag.PredmetiLista.Count == 0)
        {
            <div class="t-row" style="grid-template-columns:1fr;">
                <div class="q-text-cell">Nema predmeta. Dodaj prvi predmet dugmetom "+ Novi predmet".</div>
            </div>
        }
        else
        {
            @foreach (var p in ViewBag.PredmetiLista)
            {
                <div class="t-row subject-row" data-search="@p.Naziv.ToLowerInvariant()" style="grid-template-columns:1fr 90px 140px">
                    <div>@if (User.IsInRole("Admin")) { <input type="checkbox" class="bulk-check" data-kind="subjects" value="@p.Id" aria-label="Odaberi predmet" /> }<div class="q-text-cell">@p.Naziv</div><small>@p.BrojOblasti oblasti</small></div>
                    <span style="font-family:'Space Grotesk',sans-serif;font-weight:700;color:var(--accent)">@p.BrojPitanja</span>
                    <div class="actions-cell">
                        <button type="button" class="act-btn edit" data-id="@p.Id" data-naziv="@p.Naziv" onclick="openEditSubject(this)">Uredi</button>
                        <form asp-controller="Predmet" asp-action="DeleteFromContent" asp-route-id="@p.Id" method="post" style="display:inline;"
                              onsubmit="return confirm('Obrisati predmet? Time se brišu povezane oblasti, pitanja, kviz sesije i leaderboard/statistika za taj predmet.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="act-btn del">Obriši</button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>

<div class="panel @(activeTab == "areas" ? "active" : "")" id="areas">
    <form class="toolbar" id="areaFilterForm" onsubmit="return false;">
        <div class="search-wrap">
            <span class="search-icon">⌕</span>
            <input type="text" id="areaSearchInput" placeholder="Pretraži oblasti..." autocomplete="off">
        </div>

        <select id="areaPredmetFilter" asp-items="ViewBag.AreaPredmeti">
            <option value="">Svi predmeti</option>
        </select>


        <button type="button" class="btn-add" onclick="openAreaModal()">
            + Nova oblast
        </button>
    </form>

@if (User.IsInRole("Admin")) {
    <form asp-controller="Content" asp-action="BulkDelete" method="post" class="bulk-toolbar" data-bulk-kind="areas">
        @Html.AntiForgeryToken()
        <input type="hidden" name="kind" value="areas"><input type="hidden" name="confirmed" value="true">
