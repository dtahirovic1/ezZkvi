<style>
    body.view-content-index .toolbar .search-wrap { min-width: min(220px, 100%); flex: 1 0 220px; }
</style>

@section Scripts {
    <script>
        function updateQuestionStatistics() {
            const all = [...document.querySelectorAll('.question-row')];
            function cards(rows) {
                return ['Ukupno','Lako','Srednje','Teško'].map((name,i) => '<div>'+name+'<strong>'+(i === 0 ? rows.length : rows.filter(r => r.dataset.tezina === ['','LAKO','SREDNJE','TESKO'][i]).length)+'</strong></div>').join('');
            }
            const filtered = document.getElementById('filteredQuestionStatistics');
            if(filtered) filtered.innerHTML = cards(all.filter(r => r.style.display !== 'none'));
        }
        document.addEventListener('DOMContentLoaded', updateQuestionStatistics);

        const contentTabs = ['questions', 'areas', 'subjects'];

        function switchTab(t, updateUrl = true) {
            if (!contentTabs.includes(t)) {
                t = 'questions';
            }

            document.querySelectorAll('.tab').forEach(function (el) {
                el.classList.toggle('active', el.getAttribute('data-tab') === t);
            });

            document.querySelectorAll('.panel').forEach(function (el) {
                el.classList.remove('active');
            });

            document.getElementById(t).classList.add('active');

            if (updateUrl) {
                const url = new URL(window.location.href);
                url.searchParams.set('tab', t);
                url.hash = '';
                history.replaceState(null, '', url.pathname + '?' + url.searchParams.toString());
            }
        }

        function normalizeFilterValue(value) {
            return (value || '').toString().trim().toLowerCase();
        }

        function setRowVisible(row, visible) {
            row.style.display = visible ? '' : 'none';
            if (!visible) { const check = row.querySelector('.bulk-check'); if (check) check.checked = false; }
            document.dispatchEvent(new Event('bulk-filter-changed'));
        }

        function updateQuestionOblastFilterOptions() {
            const predmetFilter = document.getElementById('questionPredmetFilter');
            const oblastFilter = document.getElementById('questionOblastFilter');
            if (!predmetFilter || !oblastFilter) return;

            const predmetId = predmetFilter.value;

            Array.from(oblastFilter.options).forEach(function (opt) {
                const optionPredmetId = opt.getAttribute('data-predmet-id');
                const visible = !optionPredmetId || !predmetId || optionPredmetId === predmetId;
                opt.hidden = !visible;
                opt.disabled = !visible;
            });

            if (oblastFilter.selectedOptions.length && oblastFilter.selectedOptions[0].disabled) {
                oblastFilter.value = '';
            }
        }

        function applyQuestionFilter() {
            updateQuestionOblastFilterOptions();

            const search = normalizeFilterValue(document.getElementById('questionSearchInput')?.value);
            const predmetId = document.getElementById('questionPredmetFilter')?.value || '';
            const oblastId = document.getElementById('questionOblastFilter')?.value || '';
            const tezina = document.getElementById('tezinaFilter')?.value || '';

            document.querySelectorAll('.question-row').forEach(function (row) {
                const matchesSearch = !search || (row.getAttribute('data-search') || '').includes(search);
                const matchesPredmet = !predmetId || row.getAttribute('data-predmet-id') === predmetId;
                const matchesOblast = !oblastId || row.getAttribute('data-oblast-id') === oblastId;
                const matchesTezina = !tezina || row.getAttribute('data-tezina') === tezina;

                setRowVisible(row, matchesSearch && matchesPredmet && matchesOblast && matchesTezina);
            });
            updateQuestionStatistics();
        }

        function applySubjectFilter() {
            const search = normalizeFilterValue(document.getElementById('subjectSearchInput')?.value);

            document.querySelectorAll('.subject-row').forEach(function (row) {
                const matchesSearch = !search || (row.getAttribute('data-search') || '').includes(search);
                setRowVisible(row, matchesSearch);
            });
        }

        function applyAreaFilter() {
            const search = normalizeFilterValue(document.getElementById('areaSearchInput')?.value);
            const predmetId = document.getElementById('areaPredmetFilter')?.value || '';

            document.querySelectorAll('.area-row').forEach(function (row) {
                const matchesSearch = !search || (row.getAttribute('data-search') || '').includes(search);
                const matchesPredmet = !predmetId || row.getAttribute('data-predmet-id') === predmetId;
                setRowVisible(row, matchesSearch && matchesPredmet);
            });
        }

        function setupClientSideFilters() {
            document.getElementById('questionSearchInput')?.addEventListener('input', applyQuestionFilter);
            document.getElementById('questionPredmetFilter')?.addEventListener('change', applyQuestionFilter);
            document.getElementById('questionOblastFilter')?.addEventListener('change', applyQuestionFilter);
            document.getElementById('tezinaFilter')?.addEventListener('change', applyQuestionFilter);

            document.getElementById('subjectSearchInput')?.addEventListener('input', applySubjectFilter);

            document.getElementById('areaSearchInput')?.addEventListener('input', applyAreaFilter);
            document.getElementById('areaPredmetFilter')?.addEventListener('change', applyAreaFilter);
        }

        function toggleOptionsByPredmet(selectId, predmetId) {
            const select = document.getElementById(selectId);
            if (!select) return;

            Array.from(select.options).forEach(function (opt) {
                const optionPredmet = opt.getAttribute('data-predmet-id');
                if (!optionPredmet) {
                    opt.hidden = false;
                    opt.disabled = false;
                    return;
                }

                const visible = predmetId && optionPredmet === predmetId;
                opt.hidden = !visible;
                opt.disabled = !visible;
            });

            if (select.selectedOptions.length && select.selectedOptions[0].disabled) {
                select.value = '';
            }
        }

        function filterQuestionOblasti() {
            const predmetId = document.getElementById('questionPredmetSelect').value;
            toggleOptionsByPredmet('questionOblastSelect', predmetId);
        }

        function filterEditQuestionOblasti() {
            const predmetId = document.getElementById('editQuestionPredmetSelect').value;
            toggleOptionsByPredmet('editQuestionOblastSelect', predmetId);
        }

        function filterCsvOblasti() {
            const predmetId = document.getElementById('csvPredmetSelect').value;
            toggleOptionsByPredmet('csvOblastSelect', predmetId);
        }

        function openQuestionModal() {
            document.getElementById('questionModal').classList.add('open');
            filterQuestionOblasti();
        }

        function closeQuestionModal() {
            document.getElementById('questionModal').classList.remove('open');
        }

        function openEditQuestion(btn) {
            const predmetId = btn.getAttribute('data-predmet-id');
            const oblastId = btn.getAttribute('data-oblast-id');

            document.getElementById('editQuestionId').value = btn.getAttribute('data-id');
            document.getElementById('editQuestionTekst').value = btn.getAttribute('data-tekst') || '';
            document.getElementById('editQuestionPredmetSelect').value = predmetId;
            filterEditQuestionOblasti();
            document.getElementById('editQuestionOblastSelect').value = oblastId;
            document.getElementById('editQuestionTezina').value = btn.getAttribute('data-tezina');
            document.getElementById('editQuestionOdgovor1').value = btn.getAttribute('data-odgovor1') || '';
            document.getElementById('editQuestionOdgovor2').value = btn.getAttribute('data-odgovor2') || '';
            document.getElementById('editQuestionOdgovor3').value = btn.getAttribute('data-odgovor3') || '';
            document.getElementById('editQuestionOdgovor4').value = btn.getAttribute('data-odgovor4') || '';
            document.getElementById('editQuestionTacanOdgovor').value = btn.getAttribute('data-tacan-odgovor') || '1';
            document.getElementById('questionEditModal').classList.add('open');
        }

        function closeEditQuestion() {
            document.getElementById('questionEditModal').classList.remove('open');
        }

        function openCsvModal() {
            document.getElementById('csvModal').classList.add('open');
            filterCsvOblasti();
        }

        function closeCsvModal() {
            document.getElementById('csvModal').classList.remove('open');
        }

        function openSubjectModal() {
            document.getElementById('subjectModal').classList.add('open');
        }

        function closeSubjectModal() {
            document.getElementById('subjectModal').classList.remove('open');
        }

        function openEditSubject(btn) {
            document.getElementById('editSubjectId').value = btn.getAttribute('data-id');
            document.getElementById('editSubjectNaziv').value = btn.getAttribute('data-naziv');
            document.getElementById('subjectEditModal').classList.add('open');
        }

        function closeEditSubject() {
            document.getElementById('subjectEditModal').classList.remove('open');
        }

        function openAreaModal() {
            document.getElementById('areaModal').classList.add('open');
        }

        function closeAreaModal() {
            document.getElementById('areaModal').classList.remove('open');
        }

        function openEditArea(btn) {
            document.getElementById('editAreaId').value = btn.getAttribute('data-id');
            document.getElementById('editAreaNaziv').value = btn.getAttribute('data-naziv');
            document.getElementById('editAreaPredmetId').value = btn.getAttribute('data-predmet-id');
            document.getElementById('areaEditModal').classList.add('open');
        }

        function closeEditArea() {
            document.getElementById('areaEditModal').classList.remove('open');
        }

        ['csvModal', 'questionModal', 'questionEditModal', 'subjectModal', 'subjectEditModal', 'areaModal', 'areaEditModal'].forEach(function (id) {
            var el = document.getElementById(id);
            if (!el) return;
            el.addEventListener('click', function (e) {
                if (e.target !== this) return;
                this.classList.remove('open');
            });
        });

        function showToast(msg, type) {
            const t = document.getElementById('toast');
            t.textContent = msg;
            t.className = 'toast ' + type;

            setTimeout(function () { t.classList.add('show'); }, 10);
            setTimeout(function () { t.classList.remove('show'); }, 3500);
        }

        document.addEventListener('DOMContentLoaded', function () {
            setupClientSideFilters();
            applyQuestionFilter();
            applySubjectFilter();
            applyAreaFilter();

            filterQuestionOblasti();
            filterEditQuestionOblasti();
            filterCsvOblasti();

            const toast = document.getElementById('toast');
            const success = toast.getAttribute('data-success');
            const error = toast.getAttribute('data-error');

            if (success) showToast(success, 'success');
            if (error) showToast(error, 'error');
        });
    </script>
<script src="~/js/admin-bulk.js" asp-append-version="true"></script>
}
