@model ezZkvi.Models.Feedback

@{
    ViewData["Title"] = "Brisanje povratne informacije";
}

<h1>Brisanje povratne informacije</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Feedback</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TipFeedbacka)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TipFeedbacka)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DatumSlanja)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DatumSlanja)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="ID" />
        <input type="submit" value="Obriši" class="btn btn-danger" /> |
        <a asp-action="Index">Nazad na pregled</a>
    </form>
